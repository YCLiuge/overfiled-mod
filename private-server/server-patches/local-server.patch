+package game
+
+import "gucooing/lolo/db"
+
+// Existing accounts are raised to the sandbox floor without resetting experience
+// or downgrading accounts that have already progressed further.
+func applySandboxAccountLevel(userID uint32) error {
+	return updateGameBasicAtomic(userID, func(b *db.OFGameBasic) bool {
+		if b.Level >= 30 {
+			return false
+		}
+		b.Level = 30
+		return true
+	})
+}
