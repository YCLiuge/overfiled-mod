--- /dev/null
+++ b/game/router_reply.go
@@ -0,0 +1,32 @@
+package game
+
+import (
+	"google.golang.org/protobuf/reflect/protoreflect"
+	"gucooing/lolo/game/model"
+	"gucooing/lolo/pkg/alg"
+	"gucooing/lolo/protocol/cmd"
+	"gucooing/lolo/protocol/proto"
+	"strings"
+)
+
+// Reply only to registered Req/Rsp pairs with an explicit StatusCode field.
+// Notifications and unknown schemas must not receive fabricated success data.
+func (g *Game) replyUnsupported(s *model.Player, msg *alg.GameMsg) {
+	registry := cmd.Get()
+	name := registry.GetCmdNameByCmdId(msg.MsgId)
+	if !strings.HasSuffix(name, "Req") {
+		return
+	}
+	id := registry.GetCmdIdByCmdName(strings.TrimSuffix(name, "Req") + "Rsp")
+	rsp := registry.GetProtoObjByCmdId(id)
+	if rsp == nil {
+		return
+	}
+	reflected := rsp.ProtoReflect()
+	field := reflected.Descriptor().Fields().ByName("status")
+	if field == nil || field.Kind() != protoreflect.EnumKind || field.IsList() || field.Enum().FullName() != proto.StatusCode_StatusCode_BAD_REQ.Descriptor().FullName() {
+		return
+	}
+	reflected.Set(field, protoreflect.ValueOfEnum(protoreflect.EnumNumber(proto.StatusCode_StatusCode_BAD_REQ)))
+	g.send(s, msg.PacketId, rsp)
+}
