--- /dev/null
+++ b/gdconf/excel.Fishing.go
@@ -0,0 +1,69 @@
+package gdconf
+
+import (
+	"gucooing/lolo/protocol/excel"
+	"sort"
+)
+
+// Fishing retains the real client event indexes and fish/item ID mapping.
+// FishPondPool is an opaque pool reference: no pool contents ship in these tables.
+type Fishing struct {
+	LifeKind *LifeCraftKind
+	Fish     map[uint32]*excel.FishingInfoConfigure
+	Ponds    map[uint32]*excel.FishPondConfigure
+	Events   map[uint32]*excel.FishingEventConfigure
+}
+
+func (g *GameConfig) loadFishing() {
+	f := &Fishing{Fish: map[uint32]*excel.FishingInfoConfigure{}, Ponds: map[uint32]*excel.FishPondConfigure{}, Events: map[uint32]*excel.FishingEventConfigure{}}
+	var fish excel.AllFishingDatas
+	var ponds excel.AllFishPondDatas
+	ReadJson(g.excelPath, "Fishing.json", &fish)
+	ReadJson(g.excelPath, "FishPond.json", &ponds)
+	for _, v := range fish.GetFishingInfo().GetDatas() {
+		f.Fish[uint32(v.ID)] = v
+	}
+	for _, v := range fish.GetFishingEvent().GetDatas() {
+		f.Events[uint32(v.ID)] = v
+	}
+	for _, v := range ponds.GetFishPond().GetDatas() {
+		f.Ponds[uint32(v.ID)] = v
+	}
+	f.LifeKind = &LifeCraftKind{Skills: map[uint32]uint32{}}
+	for _, level := range fish.GetFishingLevel().GetDatas() {
+		if uint32(level.ID) > f.LifeKind.MaxLevel {
+			f.LifeKind.MaxLevel = uint32(level.ID)
+		}
+	}
+	for _, skill := range fish.GetFishingSpell().GetDatas() {
+		for _, level := range skill.GetFishingSpellItems() {
+			if uint32(level.Level) > f.LifeKind.Skills[uint32(skill.ID)] {
+				f.LifeKind.Skills[uint32(skill.ID)] = uint32(level.Level)
+			}
+		}
+	}
+	g.Excel.Fishing = f
+}
+func GetFishingConfig() *Fishing {
+	if cc == nil || cc.Excel == nil {
+		return nil
+	}
+	return cc.Excel.Fishing
+}
+func (f *Fishing) SandboxFishIDs() []uint32 {
+	ids := []uint32{}
+	if f == nil {
+		return ids
+	}
+	for id, v := range f.Fish {
+		// Sandbox uses visible ordinary fish, not a fabricated official pond pool.
+		if v.IsShow && v.NewFishClassifyType == 1 && v.ItemID > 0 && v.MinSize > 0 && v.MaxSize >= v.MinSize {
+			item := GetItemConfigure(uint32(v.ItemID))
+			if item != nil && item.NewBagItemTag == 13 {
+				ids = append(ids, id)
+			}
+		}
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	return ids
+}
