diff --git a/game/model/dye.go b/game/model/dye.go
new file mode 100644
index 0000000..b50f684
--- /dev/null
+++ b/game/model/dye.go
@@ -0,0 +1,192 @@
+package model
+
+import (
+	"errors"
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+	"math"
+	"math/rand"
+	"sort"
+)
+
+// These are sandbox safety limits, not reconstructed official unlock rules.
+const SandboxDyeSchemeLimit uint32 = 10
+const SandboxDyePositionLimit uint32 = 16
+
+var ErrDyeInvalid = errors.New("invalid or unsupported dye operation")
+
+// Scheme zero is the original/default appearance and works for starter clothes.
+// Nonzero selections require actual ownership and an unlocked saved scheme.
+func (s *Player) ValidateOutfitPresetDyes(p *proto.OutfitPreset) error {
+	if p == nil {
+		return ErrDyeInvalid
+	}
+	pairs := [][2]uint32{{p.Hat, p.HatDyeSchemeIndex}, {p.Hair, p.HairDyeSchemeIndex}, {p.Clothes, p.ClothesDyeSchemeIndex}, {p.Ornament, p.OrnamentDyeSchemeIndex}, {p.PendTop, p.PendTopDyeSchemeIndex}, {p.PendChest, p.PendChestDyeSchemeIndex}, {p.PendPelvis, p.PendPelvisDyeSchemeIndex}, {p.PendUpFace, p.PendUpFaceDyeSchemeIndex}, {p.PendDownFace, p.PendDownFaceDyeSchemeIndex}, {p.PendLeftHand, p.PendLeftHandDyeSchemeIndex}, {p.PendRightHand, p.PendRightHandDyeSchemeIndex}, {p.PendLeftFoot, p.PendLeftFootDyeSchemeIndex}, {p.PendRightFoot, p.PendRightFootDyeSchemeIndex}}
+	for _, pair := range pairs {
+		if pair[1] == 0 {
+			continue
+		}
+		if pair[0] == 0 || pair[1] >= SandboxDyeSchemeLimit {
+			return ErrDyeInvalid
+		}
+		f := s.dyeFashion(pair[0])
+		if f == nil || f.DyeSchemes[pair[1]] == nil || !f.DyeSchemes[pair[1]].IsUnLock {
+			return ErrDyeInvalid
+		}
+	}
+	return nil
+}
+
+type DyeModel struct {
+	OutfitID   uint32      `json:"outfitId,omitempty"`
+	ColorantID uint32      `json:"colorantId,omitempty"`
+	Pending    *PendingDye `json:"pending,omitempty"`
+}
+type PendingDye struct {
+	OutfitID    uint32    `json:"outfitId,omitempty"`
+	SchemeIndex uint32    `json:"schemeIndex,omitempty"`
+	ColorantID  uint32    `json:"colorantId,omitempty"`
+	Color       *PosColor `json:"color,omitempty"`
+}
+
+func (s *Player) dyeFashion(id uint32) *ItemFashionInfo {
+	if s == nil || s.Item == nil {
+		return nil
+	}
+	f := s.Item.GetItemFashionInfo(id)
+	c := gdconf.GetFashionAllInfo(id)
+	if f == nil || c == nil || c.FashionInfo == nil || f.OutfitId != id {
+		return nil
+	}
+	return f
+}
+func (s *Player) SelectOutfitColorant(outfit, item uint32) (*proto.OutfitDyeParam, error) {
+	d := gdconf.GetDye()
+	c := gdconf.GetItemConfigure(item)
+	if s.dyeFashion(outfit) == nil || d == nil || d.Colors[item] == nil || c == nil || proto.EBagItemTag(c.NewBagItemTag) != proto.EBagItemTag_EBagItemTag_DyeStuff {
+		return nil, ErrDyeInvalid
+	}
+	if s.Dye == nil {
+		s.Dye = &DyeModel{}
+	}
+	s.Dye.OutfitID, s.Dye.ColorantID = outfit, item
+	// The client initializes its picker from sixteen Vector4 swirl records.
+	// Empty Params aborts picker initialization. IsDye means a result has already
+	// been generated, not whether this fashion supports dyeing.
+	params := make([]float64, 64)
+	for i := 0; i < len(params); i += 4 {
+		params[i] = 0.2 + rand.Float64()*0.6
+		params[i+1] = 0.2 + rand.Float64()*0.6
+		params[i+2] = 0.2 + rand.Float64()*0.6
+		if rand.Intn(2) == 0 {
+			params[i+2] = -params[i+2]
+		}
+		// Radius must be positive: the picker divides by it.
+		params[i+3] = 0.2 + rand.Float64()*0.6
+	}
+	return &proto.OutfitDyeParam{PictureId: 1, Params: params, IsDye: false}, nil
+}
+func (s *Player) PreviewOutfitDye(req *proto.OutfitDyeReq) (*proto.PosColor, error) {
+	if req == nil || req.SchemeIndex >= SandboxDyeSchemeLimit || req.Pos >= SandboxDyePositionLimit || math.IsNaN(float64(req.Uvy)) || math.IsInf(float64(req.Uvy), 0) {
+		return nil, ErrDyeInvalid
+	}
+	f := s.dyeFashion(req.OutfitId)
+	if f == nil || f.DyeSchemes[req.SchemeIndex] == nil || !f.DyeSchemes[req.SchemeIndex].IsUnLock {
+		return nil, ErrDyeInvalid
+	}
+	colorant := uint32(0)
+	var color PosColor
+	if req.SpecifyColor != nil {
+		if req.SpecifyColor.Red > 255 || req.SpecifyColor.Green > 255 || req.SpecifyColor.Blue > 255 {
+			return nil, ErrDyeInvalid
+		}
+		color = PosColor{Pos: req.Pos, Red: req.SpecifyColor.Red, Green: req.SpecifyColor.Green, Blue: req.SpecifyColor.Blue}
+	} else {
+		if s.Dye == nil || s.Dye.OutfitID != req.OutfitId {
+			return nil, ErrDyeInvalid
+		}
+		d := gdconf.GetDye()
+		if d == nil {
+			return nil, ErrDyeInvalid
+		}
+		c := d.Colors[s.Dye.ColorantID]
+		if c == nil {
+			return nil, ErrDyeInvalid
+		}
+		colorant = s.Dye.ColorantID
+		if c.NewDyeType == 0 {
+			ids := make([]int, 0, len(d.Colors))
+			for id, v := range d.Colors {
+				if v.NewDyeType != 0 {
+					ids = append(ids, int(id))
+				}
+			}
+			sort.Ints(ids)
+			if len(ids) == 0 {
+				return nil, ErrDyeInvalid
+			}
+			c = d.Colors[uint32(ids[rand.Intn(len(ids))])]
+		}
+		color = PosColor{Pos: req.Pos, Red: uint32(c.ColorR), Green: uint32(c.ColorG), Blue: uint32(c.ColorB)}
+	}
+	if s.Dye == nil {
+		s.Dye = &DyeModel{}
+	}
+	s.Dye.Pending = &PendingDye{OutfitID: req.OutfitId, SchemeIndex: req.SchemeIndex, ColorantID: colorant, Color: &color}
+	return &proto.PosColor{Pos: color.Pos, Red: color.Red, Green: color.Green, Blue: color.Blue}, nil
+}
+func (s *Player) PendingOutfitDye() *proto.UnSaveOutfitDyeScheme {
+	if s == nil || s.Dye == nil || s.Dye.Pending == nil || s.Dye.Pending.Color == nil {
+		return nil
+	}
+	p := s.Dye.Pending
+	c := p.Color
+	return &proto.UnSaveOutfitDyeScheme{OutfitId: p.OutfitID, SchemeIndex: p.SchemeIndex, Pos: c.Pos, DyeItemId: p.ColorantID, Color: &proto.PosColor{Pos: c.Pos, Red: c.Red, Green: c.Green, Blue: c.Blue}}
+}
+func (s *Player) UnlockOutfitDye(outfit, index uint32) (*proto.ItemDetail, error) {
+	if index >= SandboxDyeSchemeLimit {
+		return nil, ErrDyeInvalid
+	}
+	f := s.dyeFashion(outfit)
+	if f == nil {
+		return nil, ErrDyeInvalid
+	}
+	if f.DyeSchemes == nil {
+		f.DyeSchemes = map[uint32]*OutfitDyeScheme{}
+	}
+	if f.DyeSchemes[index] == nil {
+		f.DyeSchemes[index] = &OutfitDyeScheme{SchemeIndex: index}
+	}
+	f.DyeSchemes[index].IsUnLock = true
+	return f.ItemDetail(), nil
+}
+func (s *Player) SaveOutfitDye(req *proto.OutFitDyeSaveReq) (*proto.PosColor, *proto.ItemDetail, error) {
+	if req == nil || req.SchemeIndex >= SandboxDyeSchemeLimit || req.Pos >= SandboxDyePositionLimit || s.Dye == nil || s.Dye.Pending == nil {
+		return nil, nil, ErrDyeInvalid
+	}
+	p := s.Dye.Pending
+	if p.OutfitID != req.OutfitId || p.SchemeIndex != req.SchemeIndex || p.Color == nil || p.Color.Pos != req.Pos {
+		return nil, nil, ErrDyeInvalid
+	}
+	f := s.dyeFashion(req.OutfitId)
+	if f == nil || f.DyeSchemes[req.SchemeIndex] == nil || !f.DyeSchemes[req.SchemeIndex].IsUnLock {
+		return nil, nil, ErrDyeInvalid
+	}
+	c := *p.Color
+	if req.IsSaveDyeResult {
+		scheme := f.DyeSchemes[req.SchemeIndex]
+		// Replace this position once; retain every other channel.
+		colors := make(Colors, 0, len(scheme.Colors)+1)
+		for _, old := range scheme.Colors {
+			if old != nil && old.Pos != c.Pos {
+				copyColor := *old
+				colors = append(colors, &copyColor)
+			}
+		}
+		colors = append(colors, &c)
+		sort.Slice(colors, func(i, j int) bool { return colors[i].Pos < colors[j].Pos })
+		scheme.Colors = colors
+	}
+	s.Dye.Pending = nil
+	return &proto.PosColor{Pos: c.Pos, Red: c.Red, Green: c.Green, Blue: c.Blue}, f.ItemDetail(), nil
+}
diff --git a/game/model/fishing.go b/game/model/fishing.go
new file mode 100644
index 0000000..7002b0a
--- /dev/null
+++ b/game/model/fishing.go
@@ -0,0 +1,163 @@
+package model
+
+import (
+	"errors"
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+	"math"
+	"sort"
+	"time"
+)
+
+func (s *Player) FishingPictorialCounts() []*proto.LifeAchieveCount {
+	out := []*proto.LifeAchieveCount{}
+	if s.Fishing == nil {
+		return out
+	}
+	for _, a := range gdconf.GetAllAchieveConfigure() {
+		if a != nil && a.ID > 0 && a.NewFunctionOfAchievement == 6 && a.NewAchieveCondition == 28 && len(a.Param) == 1 && a.Param[0] > 0 {
+			if n := s.Fishing.Catches[uint32(a.Param[0])]; n > 0 {
+				out = append(out, &proto.LifeAchieveCount{Id: uint32(a.ID), Count: n})
+			}
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Id < out[j].Id })
+	return out
+}
+
+var ErrFishing = errors.New("invalid fishing operation")
+
+// SandboxFishingDuration is a sandbox animation duration in seconds, not a
+// recovered official value. The protocol provides a complete animation plan;
+// it has no separate reel/success request. Only the game owner completes it.
+const SandboxFishingDuration = 6
+
+type FishingModel struct {
+	Catches    map[uint32]uint64  `json:"catches,omitempty"`
+	BestLength map[uint32]float32 `json:"bestLength,omitempty"`
+	Total      uint64             `json:"total,omitempty"`
+	Pending    *FishingCast       `json:"-"`
+}
+type FishingCast struct {
+	SceneID uint32
+	Due     time.Time
+	FishID  uint32
+	ItemID  uint32
+	Length  float32
+}
+
+func (s *Player) CancelFishing() {
+	if s.Fishing != nil {
+		s.Fishing.Pending = nil
+	}
+}
+func (s *Player) StartFishing(req *proto.FishingReq, sceneID uint32, now time.Time, sandbox bool) (*proto.FishingEventResult, error) {
+	if req == nil || req.IsCancel || !sandbox || sceneID == 0 {
+		return nil, ErrFishing
+	}
+	if s.Fishing != nil && s.Fishing.Pending != nil {
+		return nil, ErrFishing
+	}
+	conf := gdconf.GetFishingConfig()
+	if conf == nil || conf.Ponds[req.FishingPondId] == nil {
+		return nil, ErrFishing
+	}
+	// Rod is an owned weapon instance. Accept an owned template ID too, since the
+	// request calls it rod_id, whereas CharacterAppearance explicitly says instance.
+	var rod *ItemWeaponInfo
+	if s.Item == nil {
+		return nil, ErrFishing
+	}
+	for instance, w := range s.Item.ItemWeaponMap {
+		if w != nil && (instance == req.FishingRodId || w.WeaponId == req.FishingRodId) {
+			c := gdconf.GetWeaponAllInfo(w.WeaponId)
+			if c != nil && c.WeaponInfo != nil && c.WeaponInfo.NewWeaponType == int32(proto.EWeaponType_EWeaponType_FishingRod) {
+				rod = w
+				break
+			}
+		}
+	}
+	if rod == nil {
+		return nil, ErrFishing
+	}
+	// Zero is allowed for no bait; an explicitly selected box must be owned and
+	// really be a bait box. Sandbox does not charge bait or rod durability.
+	if req.FishingBoxId != 0 {
+		item := s.Item.ItemBaseInfo[req.FishingBoxId]
+		c := gdconf.GetItemConfigure(req.FishingBoxId)
+		if item == nil || item.Num <= 0 || c == nil || c.NewBagItemTag != int32(proto.EBagItemTag_EBagItemTag_Baitbox) {
+			return nil, ErrFishing
+		}
+	}
+	ids := conf.SandboxFishIDs()
+	if len(ids) == 0 {
+		return nil, ErrFishing
+	}
+	total := uint64(0)
+	if s.Fishing != nil {
+		total = s.Fishing.Total
+	}
+	id := ids[total%uint64(len(ids))]
+	fish := conf.Fish[id]
+	length := fish.MinSize + (fish.MaxSize-fish.MinSize)/2
+	if math.IsNaN(float64(length)) || math.IsInf(float64(length), 0) {
+		return nil, ErrFishing
+	}
+	result := &proto.FishingEventResult{CostTime: SandboxFishingDuration, FishInfos: []*proto.FishData{{ID: id, Length: length}}}
+	// All indexes are actual Fishing.json entries. These harmless success-rate
+	// events mark start/casting. Endurance-changing events are omitted because
+	// sandbox fishing consumes no durability.
+	for _, ref := range [][2]uint32{{100, 2}, {240, 1}} {
+		for _, e := range conf.Events[ref[0]].GetFishingEventItems() {
+			if uint32(e.Index) == ref[1] {
+				result.FishingEventList = append(result.FishingEventList, &proto.FishingEventMsg{ID: ref[0], Index: ref[1]})
+			}
+		}
+	}
+	if s.Fishing == nil {
+		s.Fishing = &FishingModel{}
+	}
+	s.Fishing.Pending = &FishingCast{SceneID: sceneID, Due: now.Add(SandboxFishingDuration * time.Second), FishID: id, ItemID: uint32(fish.ItemID), Length: length}
+	return result, nil
+}
+
+// CompleteFishing is called by the game loop, never a timer goroutine. The
+// pending cast is removed before crediting: duplicate ticks cannot grant twice.
+func (s *Player) CompleteFishing(now time.Time, sceneID uint32) (*proto.FishingResultNotice, *proto.PackNotice) {
+	if s.Fishing == nil || s.Fishing.Pending == nil {
+		return nil, nil
+	}
+	cast := s.Fishing.Pending
+	if sceneID == 0 || sceneID != cast.SceneID {
+		s.CancelFishing()
+		return nil, nil
+	}
+	if now.Before(cast.Due) {
+		return nil, nil
+	}
+	s.Fishing.Pending = nil
+	conf := gdconf.GetFishingConfig()
+	if conf == nil || conf.Fish[cast.FishID] == nil || uint32(conf.Fish[cast.FishID].ItemID) != cast.ItemID {
+		return &proto.FishingResultNotice{Status: proto.StatusCode_StatusCode_BAD_REQ}, nil
+	}
+	if existing := s.Item.ItemBaseInfo[cast.ItemID]; existing != nil && existing.Num == math.MaxInt64 {
+		return &proto.FishingResultNotice{Status: proto.StatusCode_StatusCode_BAD_REQ}, nil
+	}
+	item := s.AddAllTypeItem(cast.ItemID, 1)
+	if item == nil || item.EBagItemTag == nil {
+		return &proto.FishingResultNotice{Status: proto.StatusCode_StatusCode_BAD_REQ}, nil
+	}
+	if s.Fishing.Catches == nil {
+		s.Fishing.Catches = map[uint32]uint64{}
+	}
+	if s.Fishing.BestLength == nil {
+		s.Fishing.BestLength = map[uint32]float32{}
+	}
+	s.Fishing.Catches[cast.FishID]++
+	s.Fishing.Total++
+	if cast.Length > s.Fishing.BestLength[cast.FishID] {
+		s.Fishing.BestLength[cast.FishID] = cast.Length
+	}
+	s.SetActiveTime()
+	return &proto.FishingResultNotice{Status: proto.StatusCode_StatusCode_OK, Items: []*proto.ItemDetail{item.AddItemDetail()}}, &proto.PackNotice{Items: []*proto.ItemDetail{item.ItemDetail()}}
+}
