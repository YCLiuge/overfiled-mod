index 0000000..5a92a97
--- /dev/null
+++ b/game/scene_campfire.go
@@ -0,0 +1,162 @@
+package game
+
+import (
+	"math"
+	"sort"
+	"time"
+
+	pb "google.golang.org/protobuf/proto"
+	"gucooing/lolo/game/model"
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/pkg/alg"
+	"gucooing/lolo/protocol/proto"
+)
+
+// All campfire state belongs to the channel loop. Keep the session identity so
+// an old disconnect cannot remove a replacement session's campfire.
+type sceneCampFire struct {
+	owner *ScenePlayer
+	data  *proto.CampFire
+}
+type campFireCtx struct {
+	player   *ScenePlayer
+	packetID uint32
+	place    *proto.PlaceCampFireReq
+	remove   *proto.RemoveCampFireReq
+}
+
+func (g *Game) PlaceCampFire(s *model.Player, msg *alg.GameMsg) {
+	sp := g.getWordInfo().getScenePlayer(s)
+	if sp == nil || sp.channelInfo == nil {
+		g.send(s, msg.PacketId, &proto.PlaceCampFireRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+		return
+	}
+	c := sp.channelInfo
+	select {
+	case <-c.doneChan:
+		g.send(s, msg.PacketId, &proto.PlaceCampFireRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+		return
+	default:
+	}
+	select {
+	case c.campFireChan <- &campFireCtx{player: sp, packetID: msg.PacketId, place: pb.Clone(msg.Body.(*proto.PlaceCampFireReq)).(*proto.PlaceCampFireReq)}:
+	case <-c.doneChan:
+		g.send(s, msg.PacketId, &proto.PlaceCampFireRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+	}
+}
+
+func (g *Game) RemoveCampFire(s *model.Player, msg *alg.GameMsg) {
+	sp := g.getWordInfo().getScenePlayer(s)
+	if sp == nil || sp.channelInfo == nil {
+		g.send(s, msg.PacketId, &proto.RemoveCampFireRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+		return
+	}
+	c := sp.channelInfo
+	select {
+	case <-c.doneChan:
+		g.send(s, msg.PacketId, &proto.RemoveCampFireRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+		return
+	default:
+	}
+	select {
+	case c.campFireChan <- &campFireCtx{player: sp, packetID: msg.PacketId, remove: pb.Clone(msg.Body.(*proto.RemoveCampFireReq)).(*proto.RemoveCampFireReq)}:
+	case <-c.doneChan:
+		g.send(s, msg.PacketId, &proto.RemoveCampFireRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+	}
+}
+
+func (c *ChannelInfo) handleCampFire(ctx *campFireCtx) {
+	if ctx.place != nil {
+		c.placeCampFire(ctx, time.Now().Unix())
+	} else {
+		c.removeCampFire(ctx)
+	}
+}
+
+func (c *ChannelInfo) placeCampFire(ctx *campFireCtx, now int64) {
+	rsp := &proto.PlaceCampFireRsp{Status: proto.StatusCode_StatusCode_BAD_REQ}
+	defer c.sendPlayer(ctx.player, ctx.packetID, rsp)
+	if !c.actionMember(ctx.player) {
+		rsp.Status = proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL
+		return
+	}
+	req := ctx.place
+	a := gdconf.GetAppearance()
+	// NewActionType=1 is the resource-defined placement action (1050/1051/1052).
+	// Never accept ordinary emotes or fabricate a campfire for an unknown action.
+	if req == nil || req.Pos == nil || req.Rot == nil || a == nil || a.Actions[req.ActionId] == nil || a.Actions[req.ActionId].NewActionType != 1 {
+		return
+	}
+	if c.campFires == nil {
+		c.campFires = make(map[uint32]*sceneCampFire)
+	}
+	// IDs also travel through legacy Bonfire.id (int32); allocate positive IDs
+	// without reusing a live fire, including when the counter wraps.
+	for {
+		c.nextCampFireID++
+		if c.nextCampFireID > math.MaxInt32 {
+			c.nextCampFireID = 1
+		}
+		if c.campFires[c.nextCampFireID] == nil {
+			break
+		}
+	}
+	c.cancelPlayerCampFires(ctx.player)
+	data := &proto.CampFire{Id: c.nextCampFireID, PlayerId: ctx.player.UserId, Pos: pb.Clone(req.Pos).(*proto.Vector3), Rot: pb.Clone(req.Rot).(*proto.Vector3), PlaceTime: now, ActionId: req.ActionId}
+	c.campFires[data.Id] = &sceneCampFire{owner: ctx.player, data: data}
+	rsp.Status = proto.StatusCode_StatusCode_OK
+	rsp.CampFire = pb.Clone(data).(*proto.CampFire)
+	c.sendAllPlayer(0, &proto.PlaceCampFireNotice{Status: proto.StatusCode_StatusCode_OK, CampFires: []*proto.CampFire{data}})
+}
+
+func (c *ChannelInfo) removeCampFire(ctx *campFireCtx) {
+	rsp := &proto.RemoveCampFireRsp{Status: proto.StatusCode_StatusCode_BAD_REQ}
+	defer c.sendPlayer(ctx.player, ctx.packetID, rsp)
+	if !c.actionMember(ctx.player) {
+		rsp.Status = proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL
+		return
+	}
+	if ctx.remove == nil {
+		return
+	}
+	fire := c.campFires[ctx.remove.CampFireId]
+	if fire == nil || fire.owner != ctx.player {
+		return
+	}
+	delete(c.campFires, fire.data.Id)
+	rsp.Status = proto.StatusCode_StatusCode_OK
+	c.sendAllPlayer(0, &proto.RemoveCampFireNotice{Status: proto.StatusCode_StatusCode_OK, CampFireId: []uint32{fire.data.Id}})
+}
+
+func (c *ChannelInfo) cancelPlayerCampFires(player *ScenePlayer) {
+	var ids []uint32
+	for id, fire := range c.campFires {
+		if fire.owner == player {
+			delete(c.campFires, id)
+			ids = append(ids, id)
+		}
+	}
+	if len(ids) > 0 {
+		sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+		c.sendAllPlayer(0, &proto.RemoveCampFireNotice{Status: proto.StatusCode_StatusCode_OK, CampFireId: ids})
+	}
+}
+
+// Native CampsiteSystem.OnInit and OnChannelJumpChangedCallback read BonFires
+// (SceneData+0x78), while OnPlaceCampFire reads modern CampFire. Project both
+// from one state; preserve wire Vector3 integer coordinates without rescaling.
+func (c *ChannelInfo) campFireSceneData() ([]*proto.CampFire, []*proto.Bonfire) {
+	modern := make([]*proto.CampFire, 0, len(c.campFires))
+	legacy := make([]*proto.Bonfire, 0, len(c.campFires))
+	ids := make([]uint32, 0, len(c.campFires))
+	for id := range c.campFires {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	for _, id := range ids {
+		data := pb.Clone(c.campFires[id].data).(*proto.CampFire)
+		modern = append(modern, data)
+		legacy = append(legacy, &proto.Bonfire{Id: int32(data.Id), PlayerId: int64(data.PlayerId), Position: pb.Clone(data.Pos).(*proto.Vector3), Rotation: pb.Clone(data.Rot).(*proto.Vector3)})
+	}
+	return modern, legacy
+}
