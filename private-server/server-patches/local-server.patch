new file mode 100644
index 0000000..d510826
--- /dev/null
+++ b/game/model/gacha_transaction.go
@@ -0,0 +1,415 @@
+package model
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"math/rand/v2"
+	"runtime/debug"
+	"time"
+
+	"gucooing/lolo/config"
+	"gucooing/lolo/db"
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/excel"
+	"gucooing/lolo/protocol/proto"
+)
+
+var ErrGachaInvalid = errors.New("invalid gacha request or configuration")
+var ErrGachaStrict = errors.New("strict gacha payment and official guarantees are not implemented")
+
+type GachaCtx struct {
+	player      *Player
+	staged      *Player
+	req         *proto.GachaReq
+	conf        *gdconf.GachaData
+	source      *gdconf.GachaData
+	gachaInfo   *GachaInfo
+	typeInfo    *GachaTypeInfo
+	probability *gdconf.GachaProbability
+	pools       map[int][]int32
+	gachaNum    int32
+	done        bool
+	ItemTx      *ItemTransaction
+	ItemDetails []*proto.ItemDetail
+}
+
+func (s *Player) NewGachaCtx(req *proto.GachaReq) (*GachaCtx, error) {
+	return s.NewGachaCtxMode(req, config.GetGame().Sandbox)
+}
+
+// Main-loop owned: prepare never changes live player state. Run publishes only
+// fully validated detached inventory, character and history models.
+func (s *Player) NewGachaCtxMode(req *proto.GachaReq, sandbox bool) (*GachaCtx, error) {
+	if s == nil || req == nil {
+		return nil, ErrGachaInvalid
+	}
+	source := gdconf.GetGachaData(req.GachaId)
+	if source == nil || source.Conf == nil {
+		return nil, ErrGachaInvalid
+	}
+	if !sandbox {
+		return nil, ErrGachaStrict
+	}
+	n := source.Conf.Method2Count
+	if req.IsSingle {
+		n = source.Conf.Method1Count
+	}
+	if n <= 0 || n > 100 {
+		return nil, ErrGachaInvalid
+	}
+	// Clone only the models this operation owns; never copy connection/save workers.
+	data, err := json.Marshal(struct {
+		Item      *ItemModel
+		Character *CharacterModel
+		Gacha     *GachaModel
+	}{s.Item, s.Character, s.Gacha})
+	if err != nil {
+		return nil, err
+	}
+	staged := &Player{UserId: s.UserId}
+	if err = json.Unmarshal(data, staged); err != nil {
+		return nil, err
+	}
+	info := staged.GetGachaModel().GetGachaInfo(req.GachaId)
+	if info.OptionalItemId != 0 {
+		if err := staged.ChooseGachaItem(req.GachaId, info.OptionalItemId); err != nil {
+			return nil, err
+		}
+	}
+	if info.GachaTimes > math.MaxUint32-uint32(n) {
+		return nil, ErrGachaInvalid
+	}
+	resolved := source
+	if source.IsOptional() {
+		allowed := false
+		for _, id := range source.Conf.CardPoolRange {
+			if uint32(id) == info.ChoosePoolId {
+				allowed = true
+			}
+		}
+		if !allowed {
+			return nil, fmt.Errorf("%w: choose a configured child pool first", ErrGachaInvalid)
+		}
+		resolved = gdconf.GetGachaData(info.ChoosePoolId)
+		if resolved == nil || resolved.IsOptional() {
+			return nil, ErrGachaInvalid
+		}
+	}
+	p := gdconf.GetGachaProbability(resolved.Conf.NewUIGachaType)
+	if p == nil {
+		return nil, ErrGachaInvalid
+	}
+	c := &GachaCtx{player: s, staged: staged, req: &proto.GachaReq{GachaId: req.GachaId, IsSingle: req.IsSingle}, source: source, conf: resolved, gachaInfo: info, probability: p, gachaNum: n, pools: make(map[int][]int32)}
+	c.typeInfo = staged.GetGachaModel().GetGachaTypeInfo(proto.EUIGachaType(source.Conf.NewUIGachaType))
+	for _, pool := range resolved.Pools {
+		for _, reward := range pool.Items {
+			if reward == nil {
+				return nil, ErrGachaInvalid
+			}
+			item := gdconf.GetItemConfigure(uint32(reward.ItemID))
+			if item == nil {
+				return nil, ErrGachaInvalid
+			}
+			category := gachaCategory(item)
+			if category == 0 {
+				return nil, fmt.Errorf("%w: unsupported reward %d", ErrGachaInvalid, reward.ItemID)
+			}
+			c.pools[category] = append(c.pools[category], reward.ItemID)
+		}
+	}
+	required := []int{1, 2, 3, 4}
+	if resolved.Conf.NewUIGachaType == 5 {
+		required = []int{5, 6, 7, 8, 9}
+	}
+	for _, key := range required {
+		if len(c.pools[key]) == 0 {
+			return nil, fmt.Errorf("%w: empty category %d", ErrGachaInvalid, key)
+		}
+	}
+	return c, nil
+}
+
+func gachaCategory(i *excel.ItemConfigure) int {
+	switch proto.EBagItemTag(i.NewBagItemTag) {
+	case proto.EBagItemTag_EBagItemTag_Card:
+		if i.Quality >= 4 {
+			return 1
+		}
+		return 2
+	case proto.EBagItemTag_EBagItemTag_Poster:
+		if i.Quality >= 4 {
+			return 3
+		}
+		return 4
+	case proto.EBagItemTag_EBagItemTag_Fashion:
+		return 5
+	case proto.EBagItemTag_EBagItemTag_Furniture:
+		return 6
+	case proto.EBagItemTag_EBagItemTag_Weapon:
+		if i.Quality >= 4 {
+			return 7
+		}
+		return 8
+	case proto.EBagItemTag_EBagItemTag_DyeStuff:
+		return 9
+	}
+	return 0
+}
+
+func (s *Player) ChooseGachaPool(id, child uint32) error {
+	c := gdconf.GetGachaData(id)
+	target := gdconf.GetGachaData(child)
+	if c == nil || !c.IsOptional() || target == nil || target.IsOptional() || len(target.Pools) == 0 {
+		return ErrGachaInvalid
+	}
+	for _, allowed := range c.Conf.CardPoolRange {
+		if uint32(allowed) == child {
+			s.GetGachaModel().GetGachaInfo(id).ChoosePoolId = child
+			return nil
+		}
+	}
+	return ErrGachaInvalid
+}
+func (s *Player) ChooseGachaItem(id, item uint32) error {
+	c := gdconf.GetGachaData(id)
+	if c == nil || c.Conf == nil {
+		return ErrGachaInvalid
+	}
+	pool := gdconf.GetGachaRewardPool(c.Conf.OptionalPoolID)
+	// Fashion wishes are restricted to explicitly optional entries in its real pool.
+	if pool != nil {
+		for _, v := range pool.Items {
+			if uint32(v.ItemID) == item {
+				s.GetGachaModel().GetGachaInfo(id).OptionalItemId = item
+				return nil
+			}
+		}
+	}
+	if c.Conf.NewUIGachaType == 5 {
+		for _, p := range c.Pools {
+			for _, v := range p.Items {
+				if v.IsOptional && uint32(v.ItemID) == item {
+					s.GetGachaModel().GetGachaInfo(id).OptionalItemId = item
+					return nil
+				}
+			}
+		}
+	}
+	return ErrGachaInvalid
+}
+func (c *GachaCtx) draw() (int32, int) {
+	p, t := c.probability, c.typeInfo
+	// OptionalPoolID is a real reward pool separate from the ordinary method.
+	// Apply the configured selection threshold without drawing unrelated items.
+	if c.gachaInfo.OptionalItemId != 0 && c.source.Conf.OptionalNum > 0 && (c.gachaInfo.GachaTimes+1)%uint32(c.source.Conf.OptionalNum) == 0 {
+		item := gdconf.GetItemConfigure(c.gachaInfo.OptionalItemId)
+		if item != nil {
+			return int32(c.gachaInfo.OptionalItemId), gachaCategory(item)
+		}
+	}
+	category := 4
+	if c.conf.Conf.NewUIGachaType == 5 {
+		t.GuaranteeFashion++
+		t.GuaranteeDesire++
+		r := rand.Int32N(10000)
+		switch {
+		case p.GuaranteeFashion > 0 && t.GuaranteeFashion >= p.GuaranteeFashion:
+			category = 5
+		case r < p.ProbabilityFashion:
+			category = 5
+		case r < p.ProbabilityFashion+p.ProbabilityFurniture:
+			category = 6
+		case r < p.ProbabilityFashion+p.ProbabilityFurniture+p.ProbabilityWeaponSSR:
+			category = 7
+		case r < p.ProbabilityFashion+p.ProbabilityFurniture+p.ProbabilityWeaponSSR+p.ProbabilityWeaponSR:
+			category = 8
+		default:
+			category = 9
+		}
+		if category == 5 {
+			t.GuaranteeFashion = 0
+		}
+		if c.gachaInfo.OptionalItemId != 0 && p.GuaranteeDesire > 0 && t.GuaranteeDesire >= p.GuaranteeDesire {
+			t.GuaranteeDesire = 0
+			return int32(c.gachaInfo.OptionalItemId), 5
+		}
+	} else {
+		t.GuaranteeSSR++
+		t.GuaranteeSR++
+		r := rand.Int32N(10000)
+		switch {
+		case p.GuaranteeSSR > 0 && t.GuaranteeSSR >= p.GuaranteeSSR:
+			category = 1
+		case p.GuaranteeSR > 0 && t.GuaranteeSR >= p.GuaranteeSR:
+			category = 2
+		case r < p.ProbabilitySSR+p.ProbabilitySSRUP:
+			category = 1
+		case r < p.ProbabilitySSR+p.ProbabilitySSRUP+p.ProbabilitySR:
+			category = 2
+		case r < p.ProbabilitySSR+p.ProbabilitySSRUP+p.ProbabilitySR+p.ProbabilityPosterSSR:
+			category = 3
+		}
+		if category == 1 {
+			t.GuaranteeSSR = 0
+		}
+		if category == 1 || category == 2 {
+			t.GuaranteeSR = 0
+		}
+	}
+	items := c.pools[category]
+	// UP rewards must belong to this method's actual reward pool; poster-only UP
+	// pools therefore cannot leak posters into the character category.
+	if category == 1 && c.conf.BigPool != nil && (c.source.IsOptional() || rand.Int32N(2) == 0) {
+		var up []int32
+		for _, v := range c.conf.BigPool.Items {
+			for _, id := range items {
+				if v.ItemID == id {
+					up = append(up, id)
+				}
+			}
+		}
+		if len(up) > 0 {
+			items = up
+		}
+	}
+	return items[rand.IntN(len(items))], category
+}
+
+func (c *GachaCtx) Run() (err error) {
+	if c == nil || c.done {
+		return ErrGachaInvalid
+	}
+	c.done = true
+	defer func() {
+		if v := recover(); v != nil {
+			err = fmt.Errorf("gacha staging failed: %v\n%s", v, debug.Stack())
+			c.ItemDetails = nil
+			c.ItemTx = nil
+		}
+	}()
+	pack := &proto.PackNotice{Status: proto.StatusCode_StatusCode_OK}
+	var details []*proto.ItemDetail
+	for i := int32(0); i < c.gachaNum; i++ {
+		id, _ := c.draw()
+		detail, e := c.grant(uint32(id))
+		if e != nil {
+			return e
+		}
+		details = append(details, detail)
+		c.gachaInfo.GachaTimes++
+		c.staged.Gacha.Records = append(c.staged.Gacha.Records, &db.OFGachaRecord{UserID: c.player.UserId, GachaId: c.req.GachaId, ItemId: uint32(id), GachaTime: time.Now().Unix()})
+	}
+	// Absolute final balances, including repeat conversions and all created gear.
+	if c.staged.Item != nil {
+		for _, v := range c.staged.Item.ItemBaseInfo {
+			pack.Items = append(pack.Items, v.ItemDetail())
+		}
+		for _, v := range c.staged.Item.ItemWeaponMap {
+			pack.Items = append(pack.Items, v.ItemDetail())
+		}
+		for _, v := range c.staged.Item.ItemFashionMap {
+			pack.Items = append(pack.Items, v.ItemDetail())
+		}
+		for _, v := range c.staged.Item.ItemPosterMap {
+			pack.Items = append(pack.Items, v.ItemDetail())
+		}
+	}
+	if c.staged.Character != nil {
+		for _, v := range c.staged.Character.CharacterMap {
+			pack.Items = append(pack.Items, v.ItemDetail())
+		}
+	}
+	c.player.Item, c.player.Character, c.player.Gacha = c.staged.Item, c.staged.Character, c.staged.Gacha
+	c.ItemDetails = details
+	c.ItemTx = &ItemTransaction{PackNotice: pack}
+	return nil
+}
+func (c *GachaCtx) grant(id uint32) (*proto.ItemDetail, error) {
+	item := gdconf.GetItemConfigure(id)
+	if item == nil {
+		return nil, ErrGachaInvalid
+	}
+	if proto.EBagItemTag(item.NewBagItemTag) == proto.EBagItemTag_EBagItemTag_Card && c.staged.GetCharacterModel().GetCharacterInfo(id) != nil {
+		character := gdconf.GetCharacterAll(id)
+		if character == nil || character.CharacterInfo.RepeatItemID <= 0 {
+			return nil, ErrGachaInvalid
+		}
+		// The resource specifies the conversion item but no conversion count; the
+		// sandbox grants one configured repeat token per duplicate, without inventing
+		// an official conversion rate.
+		return c.grantCount(uint32(character.CharacterInfo.RepeatItemID), 1)
+	}
+	if proto.EBagItemTag(item.NewBagItemTag) == proto.EBagItemTag_EBagItemTag_Card {
+		// Future banner characters can be hidden in the UI yet have complete real
+		// resource data. Sandbox grants use that data without mutating global IsShow.
+		conf := gdconf.GetCharacterAll(id)
+		if conf == nil || conf.CharacterInfo == nil {
+			return nil, ErrGachaInvalid
+		}
+		character := newCharacterInfo(id)
+		character.UpMaxLevel()
+		preset := character.GetEquipmentPreset(character.InUseEquipmentPresetIndex)
+		weapon := c.staged.GetItemModel().AddItemWeapon(uint32(conf.CharacterInfo.DefaultWeaponID))
+		if weapon == nil {
+			return nil, ErrGachaInvalid
+		}
+		weapon.SetWearerId(id, preset.PresetIndex)
+		preset.WeaponInstanceId = weapon.InstanceId
+		for index := uint32(0); index < gdconf.GetConstant().OutfitPresetNum; index++ {
+			outfit := character.GetOutfitPreset(index)
+			if fid := uint32(conf.CharacterInfo.HatID); fid != 0 && c.staged.Item.AddItemFashion(fid) != nil {
+				outfit.Hat = fid
+			}
+			if fid := uint32(conf.CharacterInfo.HairID); fid != 0 && c.staged.Item.AddItemFashion(fid) != nil {
+				outfit.Hair = fid
+			}
+			if fid := uint32(conf.CharacterInfo.ClothID); fid != 0 && c.staged.Item.AddItemFashion(fid) != nil {
+				outfit.Clothes = fid
+			}
+		}
+		c.staged.GetCharacterModel().GetCharacterMap()[id] = character
+		return character.ItemDetail(), nil
+	}
+	return c.grantCount(id, 1)
+}
+func (c *GachaCtx) grantCount(id uint32, n int64) (*proto.ItemDetail, error) {
+	if item := c.staged.GetItemModel().GetItemBaseInfo(id); item != nil && (item.Num < 0 || item.Num > math.MaxInt64-n) {
+		return nil, ErrGachaInvalid
+	}
+	reward := c.staged.AddAllTypeItem(id, n)
+	if reward == nil || reward.EBagItemTag == nil {
+		return nil, fmt.Errorf("%w: cannot grant %d", ErrGachaInvalid, id)
+	}
+	d := reward.AddItemDetail()
+	if d == nil || d.MainItem == nil {
+		return nil, ErrGachaInvalid
+	}
+	return d, nil
+}
+
+func (s *Player) SandboxGachaRecords(id, page uint32) ([]*proto.PlayerGachaRecord, uint32, error) {
+	if gdconf.GetGachaData(id) == nil || page == 0 {
+		return nil, 0, ErrGachaInvalid
+	}
+	var records []*proto.PlayerGachaRecord
+	if s.Gacha != nil {
+		for i := len(s.Gacha.Records) - 1; i >= 0; i-- {
+			r := s.Gacha.Records[i]
+			if r != nil && r.GachaId == id {
+				records = append(records, r.PlayerGachaRecord())
+			}
+		}
+	}
+	total := uint32((len(records) + 4) / 5)
+	start := uint64(page-1) * 5
+	if start >= uint64(len(records)) {
+		return nil, total, nil
+	}
+	end := start + 5
+	if end > uint64(len(records)) {
+		end = uint64(len(records))
+	}
+	return records[start:end], total, nil
+}
