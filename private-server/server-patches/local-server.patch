diff --git a/gdconf/excel.LifeCraft.go b/gdconf/excel.LifeCraft.go
new file mode 100644
index 0000000..e3f60f6
--- /dev/null
+++ b/gdconf/excel.LifeCraft.go
@@ -0,0 +1,140 @@
+package gdconf
+
+import (
+	"encoding/json"
+	"gucooing/lolo/protocol/proto"
+	"sort"
+)
+
+// LifeCraft normalizes the four synchronous manufacturing tables. Output quantity
+// is one: these tables specify GetItemID but contain no output-count field.
+type LifeCraft struct {
+	Kinds map[proto.LifeType]*LifeCraftKind
+}
+type LifeCraftKind struct {
+	Recipes  map[uint32]*LifeCraftRecipe
+	MaxLevel uint32
+	Skills   map[uint32]uint32
+}
+type LifeCraftRecipe struct {
+	ID                    int32
+	IsShow                bool
+	GetItemID             int32
+	NeedFormulaItemID     int32
+	NeedShowbookItemID    int32
+	NeedItemID            int32
+	NeedItemCount         int32
+	OpeningTime           string
+	ClosingTime           string
+	SuccessfulProbability float32
+	CookLevel             int32
+	MakeLevel             int32
+	HandicraftLevel       int32
+	SpinLevel             int32
+	CookFoodItems         []*LifeCraftMaterial
+	MakeItems             []*LifeCraftMaterial
+	HandicraftItems       []*LifeCraftMaterial
+	SpinItems             []*LifeCraftMaterial
+}
+type LifeCraftMaterial struct {
+	ItemID        int32
+	ItemCount     int32
+	FoodItemID    int32
+	FoodItemCount int32
+}
+
+func (r *LifeCraftRecipe) Materials() []*LifeCraftMaterial {
+	out := append([]*LifeCraftMaterial{}, r.CookFoodItems...)
+	out = append(out, r.MakeItems...)
+	out = append(out, r.HandicraftItems...)
+	return append(out, r.SpinItems...)
+}
+func (g *GameConfig) loadLifeCraft() {
+	data := &LifeCraft{Kinds: map[proto.LifeType]*LifeCraftKind{}}
+	for _, spec := range []struct {
+		file, prefix, recipes string
+		kind                  proto.LifeType
+	}{{"Cooking.json", "Cook", "CookFood", 1}, {"Make.json", "Make", "MakeItem", 3}, {"Handicraft.json", "Handicraft", "HandicraftItem", 4}, {"Spin.json", "Spin", "SpinItem", 5}} {
+		var sections map[string]struct{ Datas []json.RawMessage }
+		ReadJson(g.excelPath, spec.file, &sections)
+		kind := &LifeCraftKind{Recipes: map[uint32]*LifeCraftRecipe{}, Skills: map[uint32]uint32{}}
+		for _, raw := range sections[spec.recipes].Datas {
+			r := new(LifeCraftRecipe)
+			if err := json.Unmarshal(raw, r); err != nil {
+				panic(err)
+			}
+			for _, m := range r.CookFoodItems {
+				if m != nil {
+					m.ItemID = m.FoodItemID
+					m.ItemCount = m.FoodItemCount
+				}
+			}
+			if r.ID > 0 {
+				kind.Recipes[uint32(r.ID)] = r
+			}
+		}
+		for _, raw := range sections[spec.prefix+"Level"].Datas {
+			var r struct{ ID uint32 }
+			if err := json.Unmarshal(raw, &r); err != nil {
+				panic(err)
+			}
+			if r.ID > kind.MaxLevel {
+				kind.MaxLevel = r.ID
+			}
+		}
+		for _, raw := range sections[spec.prefix+"Spell"].Datas {
+			var fields map[string]json.RawMessage
+			if err := json.Unmarshal(raw, &fields); err != nil {
+				panic(err)
+			}
+			var id uint32
+			if err := json.Unmarshal(fields["ID"], &id); err != nil {
+				panic(err)
+			}
+			var levels []struct{ Level uint32 }
+			if err := json.Unmarshal(fields[spec.prefix+"SpellItems"], &levels); err != nil {
+				panic(err)
+			}
+			for _, l := range levels {
+				if l.Level > kind.Skills[id] {
+					kind.Skills[id] = l.Level
+				}
+			}
+		}
+		data.Kinds[spec.kind] = kind
+	}
+	g.Excel.LifeCraft = data
+}
+func GetLifeCraftKind(kind proto.LifeType) *LifeCraftKind {
+	if kind == proto.LifeType_LIFE_TYPE_Fishing {
+		if fishing := GetFishingConfig(); fishing != nil {
+			return fishing.LifeKind
+		}
+		return nil
+	}
+	if cc == nil || cc.Excel == nil || cc.Excel.LifeCraft == nil {
+		return nil
+	}
+	return cc.Excel.LifeCraft.Kinds[kind]
+}
+func GetLifeCraftRecipe(kind proto.LifeType, id uint32) *LifeCraftRecipe {
+	k := GetLifeCraftKind(kind)
+	if k == nil {
+		return nil
+	}
+	return k.Recipes[id]
+}
+func GetLifeCraftRecipeIDs(kind proto.LifeType) []uint32 {
+	k := GetLifeCraftKind(kind)
+	if k == nil {
+		return nil
+	}
+	ids := []uint32{}
+	for id, r := range k.Recipes {
+		if r != nil && r.IsShow && r.GetItemID > 0 {
+			ids = append(ids, id)
+		}
+	}
+	sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	return ids
+}
