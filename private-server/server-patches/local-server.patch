@@ -0,0 +1,87 @@
+package game
+
+import (
+	"gucooing/lolo/db"
+	"gucooing/lolo/game/model"
+	"gucooing/lolo/pkg/alg"
+	"gucooing/lolo/protocol/proto"
+)
+
+// UpGameBasic mutates the cached object before saving it. Restore that object
+// on a storage failure so subsequent login/social reads see committed data.
+func updateGameBasicAtomic(userID uint32, apply func(*db.OFGameBasic) bool) error {
+	var changed *db.OFGameBasic
+	var before db.OFGameBasic
+	err := db.UpGameBasic(userID, func(basic *db.OFGameBasic) bool {
+		changed, before = basic, *basic
+		return apply(basic)
+	})
+	if err != nil && changed != nil {
+		*changed = before
+	}
+	return err
+}
+
+func (g *Game) ChangeHead(s *model.Player, msg *alg.GameMsg) {
+	if s == nil || msg == nil {
+		return
+	}
+	rsp := &proto.ChangeHeadRsp{Status: proto.StatusCode_StatusCode_BAD_REQ}
+	packetID := uint32(0)
+	if msg.PacketHead != nil {
+		packetID = msg.PacketId
+	}
+	defer func() {
+		g.send(s, packetID, rsp)
+		if rsp.Status == proto.StatusCode_StatusCode_OK {
+			g.SceneActionCharacterUpdate(s, proto.SceneActionType_SceneActionType_UPDATE_APPEARANCE)
+		}
+	}()
+	req, ok := msg.Body.(*proto.ChangeHeadReq)
+	if !ok || req == nil || !s.OwnsAppearanceExtra("head", req.Head) {
+		return
+	}
+	if err := updateGameBasicAtomic(s.UserId, func(basic *db.OFGameBasic) bool {
+		if basic.Head == req.Head {
+			return false
+		}
+		basic.Head = req.Head
+		return true
+	}); err != nil {
+		rsp.Status = proto.StatusCode_StatusCode_PLAYER_NOT_FOUND
+		return
+	}
+	rsp.Status, rsp.Head = proto.StatusCode_StatusCode_OK, req.Head
+}
+
+func (g *Game) ChangePhoneCase(s *model.Player, msg *alg.GameMsg) {
+	if s == nil || msg == nil {
+		return
+	}
+	rsp := &proto.ChangePhoneCaseRsp{Status: proto.StatusCode_StatusCode_BAD_REQ}
+	packetID := uint32(0)
+	if msg.PacketHead != nil {
+		packetID = msg.PacketId
+	}
+	defer func() {
+		g.send(s, packetID, rsp)
+		if rsp.Status == proto.StatusCode_StatusCode_OK {
+			g.SceneActionCharacterUpdate(s, proto.SceneActionType_SceneActionType_UPDATE_APPEARANCE)
+		}
+	}()
+	req, ok := msg.Body.(*proto.ChangePhoneCaseReq)
+	if !ok || req == nil || !s.OwnsAppearanceExtra("phoneCase", req.PhoneCase) {
+		return
+	}
+	if err := updateGameBasicAtomic(s.UserId, func(basic *db.OFGameBasic) bool {
+		if basic.PhoneCase == req.PhoneCase {
+			return false
+		}
+		basic.PhoneCase = req.PhoneCase
+		return true
+	}); err != nil {
+		rsp.Status = proto.StatusCode_StatusCode_PLAYER_NOT_FOUND
+		return
+	}
+	rsp.Status, rsp.PhoneCase = proto.StatusCode_StatusCode_OK, req.PhoneCase
+}
