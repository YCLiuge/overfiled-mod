+package gdconf
+
+import "gucooing/lolo/protocol/excel"
+
+// TreasureIllustration keeps each source table's IDs separate; CollectionID is
+// the reward pool ID itself, never an offset or a reward item ID.
+type TreasureIllustration struct {
+	Books    map[uint32]*excel.BookConfigure
+	Utensils map[uint32]*excel.UtensilConfigure
+	Shovels  map[uint32]*excel.ShovelConfigure
+}
+
+func (g *GameConfig) loadTreasureIllustration() {
+	books := new(excel.AllBookDatas)
+	utensils := new(excel.AllUtensilDatas)
+	shovels := new(excel.AllShovelDatas)
+	ReadJson(g.excelPath, "Book.json", &books)
+	ReadJson(g.excelPath, "Utensil.json", &utensils)
+	ReadJson(g.excelPath, "Shovel.json", &shovels)
+	info := &TreasureIllustration{
+		Books:    make(map[uint32]*excel.BookConfigure),
+		Utensils: make(map[uint32]*excel.UtensilConfigure),
+		Shovels:  make(map[uint32]*excel.ShovelConfigure),
+	}
+	for _, v := range books.GetBook().GetDatas() {
+		if v != nil && v.ID > 0 {
+			info.Books[uint32(v.ID)] = v
+		}
+	}
+	for _, v := range utensils.GetUtensil().GetDatas() {
+		if v != nil && v.ID > 0 {
+			info.Utensils[uint32(v.ID)] = v
+		}
+	}
+	for _, v := range shovels.GetShovel().GetDatas() {
+		if v != nil && v.ID > 0 {
+			info.Shovels[uint32(v.ID)] = v
+		}
+	}
+	g.Excel.TreasureIllustration = info
+}
+
+func GetTreasureIllustration() *TreasureIllustration {
+	if cc == nil || cc.Excel == nil {
+		return nil
+	}
+	return cc.Excel.TreasureIllustration
+}
