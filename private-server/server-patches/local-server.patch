diff --git a/game/model/item_use.go b/game/model/item_use.go
new file mode 100644
index 0000000..a159394
--- /dev/null
+++ b/game/model/item_use.go
@@ -0,0 +1,192 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"sort"
+
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+)
+
+var (
+	ErrGiftInvalid     = errors.New("invalid gift use request")
+	ErrGiftUnsupported = errors.New("unsupported gift semantics")
+	ErrGiftConfig      = errors.New("incomplete gift configuration")
+	ErrGiftNotEnough   = errors.New("not enough gift items")
+	ErrGiftOverflow    = errors.New("gift quantity overflow")
+)
+
+// giftBaseTag deliberately permits only ordinary stackable inventory records.
+// Equipment, characters, unlocks, experience and energy require separate logic.
+func giftBaseTag(tag proto.EBagItemTag) bool {
+	switch tag {
+	case proto.EBagItemTag_EBagItemTag_Gift,
+		proto.EBagItemTag_EBagItemTag_Currency,
+		proto.EBagItemTag_EBagItemTag_Agentia,
+		proto.EBagItemTag_EBagItemTag_IntimacyGift,
+		proto.EBagItemTag_EBagItemTag_Material,
+		proto.EBagItemTag_EBagItemTag_Fragment,
+		proto.EBagItemTag_EBagItemTag_StrengthStone,
+		proto.EBagItemTag_EBagItemTag_ExpBook:
+		return true
+	}
+	return false
+}
+
+// UseGift is owned by the game loop. It stages and validates the entire change
+// before touching inventory; it does not use the upstream deduction transaction.
+// Rewards contain gains, while PackNotice contains final absolute balances.
+func (s *Player) UseGift(itemID, num, choose uint32) ([]*proto.ItemDetail, *proto.PackNotice, error) {
+	return s.useGift(itemID, num, choose, false)
+}
+
+// UseSandboxGift grants configured rewards without requiring or consuming the
+// source gift. Configuration and reward balance checks remain identical.
+func (s *Player) UseSandboxGift(itemID, num, choose uint32) ([]*proto.ItemDetail, *proto.PackNotice, error) {
+	return s.useGift(itemID, num, choose, true)
+}
+
+func (s *Player) useGift(itemID, num, choose uint32, sandbox bool) ([]*proto.ItemDetail, *proto.PackNotice, error) {
+	fail := func(err error) ([]*proto.ItemDetail, *proto.PackNotice, error) { return nil, nil, err }
+	if s == nil || itemID == 0 || num == 0 {
+		return fail(ErrGiftInvalid)
+	}
+	if choose != 0 {
+		return fail(ErrGiftUnsupported)
+	}
+	conf := gdconf.GetItemConfigure(itemID)
+	if conf == nil || conf.ID <= 0 || uint32(conf.ID) != itemID || conf.RelateID <= 0 {
+		return fail(ErrGiftConfig)
+	}
+	if proto.EBagItemTag(conf.NewBagItemTag) != proto.EBagItemTag_EBagItemTag_Gift {
+		return fail(ErrGiftUnsupported)
+	}
+	gift := gdconf.GetGiftBag(uint32(conf.RelateID))
+	if gift == nil || gift.ID != conf.RelateID || len(gift.GiftBagGroup) == 0 {
+		return fail(ErrGiftConfig)
+	}
+	// Higher level gates, additional costs, selectable and animated/special
+	// gifts are not implemented. The daily gifts have PlayerLv=1 and no costs.
+	if gift.PlayerLv != 1 || gift.UseItemID != 0 || gift.UseItemCount != 0 || gift.NewSpecialGiftBag != 0 || gift.AssetPath != "" {
+		return fail(ErrGiftUnsupported)
+	}
+	gains := make(map[uint32]int64)
+	for _, group := range gift.GiftBagGroup {
+		if group == nil || group.RewardPoolGroupID <= 0 {
+			return fail(ErrGiftConfig)
+		}
+		pool := gdconf.GetRewardPool(uint32(group.RewardPoolGroupID))
+		if pool == nil || pool.ID != group.RewardPoolGroupID || len(pool.RewardPoolGroup) == 0 {
+			return fail(ErrGiftConfig)
+		}
+		for _, ref := range pool.RewardPoolGroup {
+			if ref == nil || ref.RewardPoolGroupID <= 0 {
+				return fail(ErrGiftConfig)
+			}
+			items := gdconf.GetRewardItemPool(uint32(ref.RewardPoolGroupID))
+			if items == nil || items.ID != ref.RewardPoolGroupID || len(items.RewardItemPoolGroup) == 0 {
+				return fail(ErrGiftConfig)
+			}
+			for _, reward := range items.RewardItemPoolGroup {
+				if reward == nil || reward.ItemID <= 0 || reward.ItemMinCount <= 0 {
+					return fail(ErrGiftConfig)
+				}
+				// Current player level handling is incomplete; accept only the
+				// unconditional 1..100 range used by both daily gifts.
+				if reward.ItemMinCount != reward.ItemMaxCount || len(reward.NeedItems) != 0 || reward.MinLevelLimit != 1 || reward.MaxLevelLimit != 100 {
+					return fail(ErrGiftUnsupported)
+				}
+				id := uint32(reward.ItemID)
+				rc := gdconf.GetItemConfigure(id)
+				if rc == nil || rc.ID != reward.ItemID {
+					return fail(ErrGiftConfig)
+				}
+				if !giftBaseTag(proto.EBagItemTag(rc.NewBagItemTag)) {
+					return fail(ErrGiftUnsupported)
+				}
+				count := int64(reward.ItemMinCount)
+				if count > math.MaxInt64/int64(num) {
+					return fail(ErrGiftOverflow)
+				}
+				count *= int64(num)
+				if gains[id] > math.MaxInt64-count {
+					return fail(ErrGiftOverflow)
+				}
+				gains[id] += count
+			}
+		}
+	}
+	i := s.Item
+	if i == nil {
+		if !sandbox {
+			return fail(ErrGiftNotEnough)
+		}
+		// Keep a fresh inventory detached until every reward is validated.
+		i = &ItemModel{}
+	}
+	i.transactionLock.Lock()
+	defer i.transactionLock.Unlock()
+	if !sandbox {
+		owned := i.ItemBaseInfo[itemID]
+		if owned == nil || owned.Num < int64(num) {
+			return fail(ErrGiftNotEnough)
+		}
+	}
+	// Build detached records before applying anything, including when the gift
+	// itself appears among its rewards. No map or existing record is mutated yet.
+	deltas := make(map[uint32]int64, len(gains)+1)
+	for id, gain := range gains {
+		deltas[id] = gain
+	}
+	if !sandbox {
+		deltas[itemID] -= int64(num)
+	}
+	ids := make([]uint32, 0, len(deltas))
+	staged := make(map[uint32]*ItemBaseInfo, len(deltas))
+	for id, delta := range deltas {
+		rc := gdconf.GetItemConfigure(id)
+		if rc == nil {
+			return fail(ErrGiftConfig)
+		}
+		record := &ItemBaseInfo{ItemId: id, ItemType: proto.EBagItemTag(rc.NewBagItemTag), PackType: proto.ItemDetail_PackType_Inventory}
+		if old := i.ItemBaseInfo[id]; old != nil {
+			if old.ItemId != id || old.ItemType != record.ItemType || old.Num < 0 {
+				return fail(fmt.Errorf("%w: invalid stored item %d", ErrGiftConfig, id))
+			}
+			*record = *old
+		}
+		if delta > 0 && record.Num > math.MaxInt64-delta {
+			return fail(ErrGiftOverflow)
+		}
+		if delta < 0 && record.Num < -delta {
+			return fail(ErrGiftNotEnough)
+		}
+		record.Num += delta
+		staged[id] = record
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(a, b int) bool { return ids[a] < ids[b] })
+	pack := &proto.PackNotice{Status: proto.StatusCode_StatusCode_OK}
+	var rewards []*proto.ItemDetail
+	for _, id := range ids {
+		record := staged[id]
+		pack.Items = append(pack.Items, record.ItemDetail())
+		if gain := gains[id]; gain > 0 {
+			copyRecord := *record
+			copyRecord.Num = gain
+			rewards = append(rewards, copyRecord.ItemDetail())
+		}
+	}
+	if i.ItemBaseInfo == nil {
+		i.ItemBaseInfo = make(map[uint32]*ItemBaseInfo, len(staged))
+	}
+	for id, record := range staged {
+		i.ItemBaseInfo[id] = record
+	}
+	if s.Item == nil {
+		s.Item = i
+	}
+	return rewards, pack, nil
+}
diff --git a/game/model/life_craft.go b/game/model/life_craft.go
new file mode 100644
index 0000000..4b52282
--- /dev/null
+++ b/game/model/life_craft.go
@@ -0,0 +1,200 @@
+package model
+
+import (
+	"encoding/json"
+	"errors"
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+	"math"
+	"sort"
+)
+
+var ErrLifeCraft = errors.New("invalid or unsupported life crafting operation")
+
+type LifeModel struct {
+	Levels  map[proto.LifeType]uint32            `json:"levels,omitempty"`
+	Crafted map[proto.LifeType]map[uint32]uint32 `json:"crafted,omitempty"`
+}
+
+func (s *Player) ApplySandboxLife() {
+	if s.Life == nil {
+		s.Life = &LifeModel{}
+	}
+	if s.Life.Levels == nil {
+		s.Life.Levels = map[proto.LifeType]uint32{}
+	}
+	for _, kind := range []proto.LifeType{1, 2, 3, 4, 5} {
+		if c := gdconf.GetLifeCraftKind(kind); c != nil && c.MaxLevel > s.Life.Levels[kind] {
+			s.Life.Levels[kind] = c.MaxLevel
+		}
+	}
+}
+func (s *Player) LifeBase(kind proto.LifeType, sandbox bool) *proto.LifeBaseInfo {
+	if kind < 1 || kind > 6 {
+		return nil
+	}
+	level := uint32(1)
+	if s.Life != nil && s.Life.Levels[kind] > level {
+		level = s.Life.Levels[kind]
+	}
+	if c := gdconf.GetLifeCraftKind(kind); sandbox && c != nil && c.MaxLevel > level {
+		level = c.MaxLevel
+	}
+	return &proto.LifeBaseInfo{LifeType: kind, Level: level}
+}
+func (s *Player) LifeSkills(kind proto.LifeType, sandbox bool) *proto.LifeSkill {
+	if kind < 1 || kind > 6 {
+		return nil
+	}
+	out := &proto.LifeSkill{LifeType: kind}
+	if c := gdconf.GetLifeCraftKind(kind); sandbox && c != nil {
+		ids := []uint32{}
+		for id := range c.Skills {
+			ids = append(ids, id)
+		}
+		sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+		for _, id := range ids {
+			out.LifeSkillInfo = append(out.LifeSkillInfo, &proto.SingleLifeSkillInfo{SkillId: id, Lv: c.Skills[id]})
+		}
+	}
+	return out
+}
+
+// LifePictorialCounts reports actual recipe-count conditions from Achieve.json.
+// Recipe IDs and achievement IDs are different domains; use only the explicit
+// Param recipe reference and matching life-condition enum to join them.
+func (s *Player) LifePictorialCounts(kind proto.LifeType) []*proto.LifeAchieveCount {
+	if kind == proto.LifeType_LIFE_TYPE_Fishing {
+		return s.FishingPictorialCounts()
+	}
+	if s.Life == nil {
+		return nil
+	}
+	var condition proto.EAchieveCondition
+	switch kind {
+	case 1:
+		condition = proto.EAchieveCondition_EAchieveCondition_CookingNum01
+	case 3:
+		condition = proto.EAchieveCondition_EAchieveCondition_MakeNum01
+	case 4:
+		condition = proto.EAchieveCondition_EAchieveCondition_HandicraftNum01
+	case 5:
+		condition = proto.EAchieveCondition_EAchieveCondition_SpinNum01
+	default:
+		return nil
+	}
+	function := map[proto.LifeType]int32{1: 4, 3: 13, 4: 11, 5: 15}[kind]
+	out := []*proto.LifeAchieveCount{}
+	for _, a := range gdconf.GetAllAchieveConfigure() {
+		if a == nil || a.ID <= 0 || a.NewFunctionOfAchievement != function || proto.EAchieveCondition(a.NewAchieveCondition) != condition || len(a.Param) != 1 || a.Param[0] <= 0 {
+			continue
+		}
+		recipe := uint32(a.Param[0])
+		if gdconf.GetLifeCraftRecipe(kind, recipe) == nil {
+			continue
+		}
+		count := s.Life.Crafted[kind][recipe]
+		if count > 0 {
+			out = append(out, &proto.LifeAchieveCount{Id: uint32(a.ID), Count: uint64(count)})
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Id < out[j].Id })
+	return out
+}
+func (s *Player) LifeAchievements(kind proto.LifeType) *proto.LifeAchieve {
+	out := &proto.LifeAchieve{LifeType: kind}
+	for _, count := range s.LifePictorialCounts(kind) {
+		out.LifeAchieve = append(out.LifeAchieve, &proto.Achieve{AchieveId: count.Id, Count: count.Count})
+	}
+	return out
+}
+
+// CraftLife produces one item immediately in sandbox mode; the protocol carries
+// a recipe ID, not a batch count or queue ID. Strict probability/time/skill rules
+// are not implemented and must not be bypassed outside sandbox mode.
+func (s *Player) CraftLife(kind proto.LifeType, id uint32, sandbox bool) (*proto.LifeCommonResult, *proto.PackNotice, error) {
+	if !sandbox || id == 0 {
+		return nil, nil, ErrLifeCraft
+	}
+	r := gdconf.GetLifeCraftRecipe(kind, id)
+	if r == nil || r.ID != int32(id) || !r.IsShow || r.GetItemID <= 0 {
+		return nil, nil, ErrLifeCraft
+	}
+	c := gdconf.GetItemConfigure(uint32(r.GetItemID))
+	if c == nil {
+		return nil, nil, ErrLifeCraft
+	}
+	// Validate material references without charging them in sandbox. Bad resource
+	// rows must still fail before any inventory or history changes.
+	if r.NeedItemCount < 0 || r.NeedItemID < 0 {
+		return nil, nil, ErrLifeCraft
+	}
+	if r.NeedItemCount > 0 && (r.NeedItemID == 0 || gdconf.GetItemConfigure(uint32(r.NeedItemID)) == nil) {
+		return nil, nil, ErrLifeCraft
+	}
+	for _, m := range r.Materials() {
+		if m == nil || m.ItemID <= 0 || m.ItemCount <= 0 || gdconf.GetItemConfigure(uint32(m.ItemID)) == nil {
+			return nil, nil, ErrLifeCraft
+		}
+	}
+	var count uint32
+	if s.Life != nil {
+		count = s.Life.Crafted[kind][id]
+	}
+	if count == math.MaxUint32 {
+		return nil, nil, ErrLifeCraft
+	}
+	tag := proto.EBagItemTag(c.NewBagItemTag)
+	if !shopBaseTag(tag) && tag != proto.EBagItemTag_EBagItemTag_Fashion {
+		return nil, nil, ErrLifeCraft
+	}
+	itemID := uint32(r.GetItemID)
+	if shopBaseTag(tag) && s.Item != nil {
+		if old := s.Item.ItemBaseInfo[itemID]; old != nil && (old.Num < 0 || old.Num == math.MaxInt64 || old.ItemId != itemID || old.ItemType != tag || old.PackType != proto.ItemDetail_PackType_Inventory) {
+			return nil, nil, ErrLifeCraft
+		}
+	}
+	// Clone to stage specialized fashion initialization too. A failed config lookup
+	// cannot allocate maps or alter dye settings on the live player's inventory.
+	staged := &ItemModel{}
+	if s.Item != nil {
+		raw, err := json.Marshal(s.Item)
+		if err != nil {
+			return nil, nil, err
+		}
+		if err = json.Unmarshal(raw, staged); err != nil {
+			return nil, nil, err
+		}
+	}
+	var gained, absolute *proto.ItemDetail
+	if shopBaseTag(tag) {
+		record := staged.AddItemBase(itemID, 1)
+		if record == nil {
+			return nil, nil, ErrLifeCraft
+		}
+		absolute = record.ItemDetail()
+		delta := *record
+		delta.Num = 1
+		gained = delta.ItemDetail()
+	} else {
+		fashion := staged.AddItemFashion(itemID)
+		if fashion == nil {
+			return nil, nil, ErrLifeCraft
+		}
+		absolute = fashion.ItemDetail()
+		gained = fashion.ItemDetail()
+	}
+	// Commit boundary: no validation follows.
+	s.Item = staged
+	if s.Life == nil {
+		s.Life = &LifeModel{}
+	}
+	if s.Life.Crafted == nil {
+		s.Life.Crafted = map[proto.LifeType]map[uint32]uint32{}
+	}
+	if s.Life.Crafted[kind] == nil {
+		s.Life.Crafted[kind] = map[uint32]uint32{}
+	}
+	s.Life.Crafted[kind][id] = count + 1
+	return &proto.LifeCommonResult{ResultItems: []*proto.ItemDetail{gained}, IsSuccess: true, LifeType: kind}, &proto.PackNotice{Status: proto.StatusCode_StatusCode_OK, Items: []*proto.ItemDetail{absolute}}, nil
+}
diff --git a/game/model/sandbox.go b/game/model/sandbox.go
new file mode 100644
index 0000000..50d194d
--- /dev/null
+++ b/game/model/sandbox.go
@@ -0,0 +1,54 @@
+package model
+
+import (
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+)
+
+const SandboxResourceFloor int64 = 99999999
+
+// Wu is present in Character.json (NameID 202004, named 乌 in String.json),
+// including weapon, skills and outfits, but has IsShow=false in this snapshot.
+// Grant this verified character in sandbox without enabling other hidden rows.
+const sandboxWuCharacterID uint32 = 202004
+
+func sandboxCharacterAvailable(c *gdconf.CharacterAllInfo) bool {
+	return c != nil && c.CharacterInfo != nil &&
+		(c.CharacterInfo.IsShow || c.CharacterId == sandboxWuCharacterID)
+}
+
+// ApplySandbox preserves existing characters and equipment. Repeated logins
+// replenish ordinary resources to a floor rather than multiplying inventory.
+func (s *Player) ApplySandbox() {
+	for _, c := range gdconf.GetCharacterAllMap() {
+		if !sandboxCharacterAvailable(c) {
+			continue
+		}
+		character := s.GetCharacterModel().GetCharacterInfo(c.CharacterId)
+		if character == nil {
+			character = s.addCharacter(c.CharacterId, true)
+		}
+		if character != nil {
+			character.IsUnlockPayment = true
+		}
+	}
+	s.ApplySandboxAppearance()
+	s.ApplySandboxAppearanceExtras()
+	for _, c := range gdconf.GetAllItemConfigure() {
+		if c == nil || c.ID <= 0 {
+			continue
+		}
+		tag := proto.EBagItemTag(c.NewBagItemTag)
+		// Only records handled as plain inventory quantities; equipment remains
+		// initialized through AddCharacter, with its required appearance and presets.
+		if !giftBaseTag(tag) && tag != proto.EBagItemTag_EBagItemTag_DyeStuff && tag != proto.EBagItemTag_EBagItemTag_Food && tag != proto.EBagItemTag_EBagItemTag_Recipe && tag != proto.EBagItemTag_EBagItemTag_Furniture {
+			continue
+		}
+		existing := s.GetItemModel().GetItemBaseInfo(uint32(c.ID))
+		if existing == nil {
+			s.GetItemModel().AddItemBase(uint32(c.ID), SandboxResourceFloor)
+		} else if existing.Num < SandboxResourceFloor {
+			existing.Num = SandboxResourceFloor
+		}
+	}
+}
diff --git a/game/model/sandbox_appearance.go b/game/model/sandbox_appearance.go
new file mode 100644
index 0000000..4db4690
--- /dev/null
+++ b/game/model/sandbox_appearance.go
@@ -0,0 +1,56 @@
+package model
+
+import (
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+	"sort"
+)
+
+// ApplySandboxAppearance only adds missing ownership; it never replaces a worn
+// preset or an existing dye scheme, nor generates duplicate equipment instances.
+func (s *Player) ApplySandboxAppearance() {
+	for id, c := range gdconf.GetFashionAllMap() {
+		if id == 0 || c == nil || c.FashionInfo == nil || c.FashionInfo.ItemID <= 0 {
+			continue
+		}
+		item := gdconf.GetItemConfigure(uint32(c.FashionInfo.ItemID))
+		if item == nil || proto.EBagItemTag(item.NewBagItemTag) != proto.EBagItemTag_EBagItemTag_Fashion {
+			continue
+		}
+		s.GetItemModel().AddItemFashion(id)
+	}
+	// Default chat stickers do not necessarily have corresponding Item records.
+	for id, c := range gdconf.GetChatEmotionMap() {
+		if id > 0 && c != nil {
+			s.GetChatModel().AddUnExpression(uint32(id))
+		}
+	}
+	a := gdconf.GetAppearance()
+	if a == nil {
+		return
+	}
+	chat := s.GetChatModel()
+	if chat.UnLockAction == nil {
+		chat.UnLockAction = map[uint32]bool{}
+	}
+	for id := range a.UnlockActions {
+		chat.UnLockAction[id] = true
+	}
+}
+
+// SandboxActionUnlockNotice is rebuilt from persisted ownership. It only sends
+// valid configured public actions and a stable order, with no study cooldown.
+func (s *Player) SandboxActionUnlockNotice() *proto.AchieveActionUnLockNotice {
+	notice := &proto.AchieveActionUnLockNotice{Status: proto.StatusCode_StatusCode_OK, StudyAction: map[uint32]int64{}}
+	a := gdconf.GetAppearance()
+	if a == nil || s.Chat == nil {
+		return notice
+	}
+	for id, owned := range s.Chat.UnLockAction {
+		if owned && a.UnlockActions[id] {
+			notice.ActionIdLst = append(notice.ActionIdLst, id)
+		}
+	}
+	sort.Slice(notice.ActionIdLst, func(i, j int) bool { return notice.ActionIdLst[i] < notice.ActionIdLst[j] })
+	return notice
+}
diff --git a/game/model/sandbox_appearance_extras.go b/game/model/sandbox_appearance_extras.go
new file mode 100644
index 0000000..aba76ae
--- /dev/null
+++ b/game/model/sandbox_appearance_extras.go
@@ -0,0 +1,112 @@
+package model
+
+import (
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+	"math"
+)
+
+// ApplySandboxAppearanceExtras grants missing ownership without replacing any
+// worn equipment, dye settings, existing instances or avatar timestamps.
+func (s *Player) ApplySandboxAppearanceExtras() {
+	a := gdconf.GetAppearanceExtras()
+	if s == nil || a == nil {
+		return
+	}
+	bag := s.GetItemModel()
+	for id := range a.Base {
+		old := bag.GetItemBaseInfo(id)
+		if old == nil {
+			bag.AddItemBase(id, 1)
+		} else if old.Num < 1 {
+			old.Num = 1
+		}
+	}
+	for _, id := range a.Categories["head"] {
+		bag.AddHead(id)
+	}
+	owned := map[uint32]bool{}
+	// Old snapshots may have an allocator behind their actual instance IDs.
+	maxID := bag.InstanceIndex
+	for id, w := range bag.ItemWeaponMap {
+		if id > maxID {
+			maxID = id
+		}
+		if w != nil && w.ItemBaseInfo != nil {
+			owned[w.ItemId] = true
+		}
+	}
+	for id := range bag.ItemArmorMap {
+		if id > maxID {
+			maxID = id
+		}
+	}
+	for id := range bag.ItemPosterMap {
+		if id > maxID {
+			maxID = id
+		}
+	}
+	for id := range bag.ItemInscriptionMap {
+		if id > maxID {
+			maxID = id
+		}
+	}
+	for id := range bag.ItemPetInfoMap {
+		if id > maxID {
+			maxID = id
+		}
+	}
+	for _, category := range []string{"collectionGloves", "loggingAxe", "miningHammer", "insectNet", "waterBottle", "fishingRod", "vehicle", "shovel"} {
+		for _, id := range a.Categories[category] {
+			if owned[id] || maxID == math.MaxUint32 {
+				continue
+			}
+			bag.InstanceIndex = maxID
+			conf := a.Weapons[id]
+			if conf != nil && bag.AddItemWeapon(uint32(conf.ID)) != nil {
+				owned[id] = true
+				maxID = bag.InstanceIndex
+			}
+		}
+	}
+}
+
+// OwnsAppearanceExtra is read-only. Weapons accept either the owned instance ID
+// used by equipment requests, or a canonical ItemID with at least one owned
+// instance. A category mismatch never falls through to generic inventory tags.
+func (s *Player) OwnsAppearanceExtra(category string, id uint32) bool {
+	a := gdconf.GetAppearanceExtras()
+	if s == nil || s.Item == nil || a == nil || id == 0 {
+		return false
+	}
+	matches := func(itemID uint32) bool {
+		for _, v := range a.Categories[category] {
+			if v == itemID {
+				return true
+			}
+		}
+		return false
+	}
+	if category == "head" {
+		h := s.Item.ItemHeadMap[id]
+		return matches(id) && h != nil && h.HeadId == id
+	}
+	switch category {
+	case "badge", "umbrella", "pendant", "avatarFrame", "phoneCase":
+		b := s.Item.ItemBaseInfo[id]
+		return matches(id) && b != nil && b.ItemId == id && b.ItemType == a.Base[id] && b.Num > 0 && b.PackType == proto.ItemDetail_PackType_Inventory
+	default:
+		if w := s.Item.ItemWeaponMap[id]; w != nil && w.ItemBaseInfo != nil && w.InstanceId == id && w.ItemType == proto.EBagItemTag_EBagItemTag_Weapon && matches(w.ItemId) {
+			return true
+		}
+		if !matches(id) || a.Weapons[id] == nil {
+			return false
+		}
+		for _, w := range s.Item.ItemWeaponMap {
+			if w != nil && w.ItemBaseInfo != nil && w.ItemId == id && w.InstanceId != 0 && w.ItemType == proto.EBagItemTag_EBagItemTag_Weapon {
+				return true
+			}
+		}
+	}
+	return false
+}
