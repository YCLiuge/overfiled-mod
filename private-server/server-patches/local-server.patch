diff --git a/game/player_fishing.go b/game/player_fishing.go
new file mode 100644
index 0000000..ae2070b
--- /dev/null
+++ b/game/player_fishing.go
@@ -0,0 +1,59 @@
+package game
+
+import (
+	"gucooing/lolo/config"
+	"gucooing/lolo/game/model"
+	"gucooing/lolo/pkg/alg"
+	"gucooing/lolo/protocol/proto"
+	"time"
+)
+
+func (g *Game) Fishing(s *model.Player, msg *alg.GameMsg) {
+	rsp := &proto.FishingRsp{Status: proto.StatusCode_StatusCode_BAD_REQ}
+	defer func() { g.send(s, msg.PacketId, rsp) }()
+	req, ok := msg.Body.(*proto.FishingReq)
+	if !ok || req == nil {
+		return
+	}
+	rsp.IsCancel = req.IsCancel
+	if req.IsCancel {
+		s.CancelFishing()
+		rsp.Status = proto.StatusCode_StatusCode_OK
+		return
+	}
+	scene := g.getWordInfo().getScenePlayer(s)
+	if scene == nil || scene.CurScene == nil {
+		return
+	}
+	result, err := s.StartFishing(req, scene.CurScene.GetSceneId(), time.Now(), config.GetGame().Sandbox)
+	if err != nil {
+		return
+	}
+	rsp.Status = proto.StatusCode_StatusCode_OK
+	rsp.FishingEventResult = result
+}
+
+// TickFishing runs only from gameMainLoop. Scene channel state is read via the
+// game-owned ScenePlayer reference; no scene-channel mutation is performed.
+func (g *Game) TickFishing(s *model.Player, now time.Time) {
+	if s.Fishing == nil || s.Fishing.Pending == nil {
+		return
+	}
+	if !s.Online || s.NetFreeze || s.Conn == nil {
+		s.CancelFishing()
+		return
+	}
+	scene := g.getWordInfo().getScenePlayer(s)
+	if scene == nil || scene.CurScene == nil {
+		s.CancelFishing()
+		return
+	}
+	result, pack := s.CompleteFishing(now, scene.CurScene.GetSceneId())
+	if result == nil {
+		return
+	}
+	if pack != nil {
+		g.send(s, 0, pack)
+	}
+	g.send(s, 0, result)
+}
