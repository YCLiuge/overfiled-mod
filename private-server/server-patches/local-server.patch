+)
+
+func (g *Game) TreasureIllustrationReward(s *model.Player, msg *alg.GameMsg) {
+	rsp := &proto.TreasureIllustrationRewardRsp{Status: proto.StatusCode_StatusCode_BAD_REQ}
+	defer func() { g.send(s, msg.PacketId, rsp) }()
+	req, ok := msg.Body.(*proto.TreasureIllustrationRewardReq)
+	if !ok || req == nil {
+		return
+	}
+	rsp.ArchaeologyType = req.ArchaeologyType
+	rsp.Id = req.Id
+	if !config.GetGame().Sandbox {
+		return
+	}
+	rewards, notice, err := s.ClaimTreasureIllustration(req.ArchaeologyType, req.Id)
+	if err != nil {
+		log.Game.Warnf("TreasureIllustrationReward type:%v id:%d rejected: %v", req.ArchaeologyType, req.Id, err)
+		return
+	}
+	rsp.Status = proto.StatusCode_StatusCode_OK
+	rsp.Rewards = rewards
+	if notice != nil {
+		g.send(s, 0, notice)
+	}
+}
