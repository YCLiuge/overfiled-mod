new file mode 100644
index 0000000..1d856a5
--- /dev/null
+++ b/gdconf/excel.Appearance.go
@@ -0,0 +1,58 @@
+package gdconf
+
+import "gucooing/lolo/protocol/excel"
+
+// Appearance joins player-facing expression groups to their actual animations.
+// Internal actions used by cutscenes are not independently unlockable emotes.
+type Appearance struct {
+	Actions         map[uint32]*excel.ActionInfoConfigure
+	MultipleActions map[uint32]*excel.MultiplayerExpressionConfigure // invitation action -> resource-defined participant roles
+	Expressions     map[uint32]*excel.ExpressionConfigure
+	UnlockActions   map[uint32]bool
+}
+
+func (g *GameConfig) loadAppearance() {
+	actions := new(excel.AllActionDatas)
+	expressions := new(excel.AllExpressionDatas)
+	ReadJson(g.excelPath, "Action.json", actions)
+	ReadJson(g.excelPath, "Expression.json", expressions)
+	a := &Appearance{Actions: map[uint32]*excel.ActionInfoConfigure{}, Expressions: map[uint32]*excel.ExpressionConfigure{}, UnlockActions: map[uint32]bool{}}
+	for _, c := range actions.GetActionInfo().GetDatas() {
+		if c != nil && c.ID > 0 && c.AnimPrefab != "" {
+			a.Actions[uint32(c.ID)] = c
+		}
+	}
+	for _, e := range expressions.GetExpression().GetDatas() {
+		if e == nil || e.ID <= 0 {
+			continue
+		}
+		a.Expressions[uint32(e.ID)] = e
+		for _, group := range e.ExpressionGroupInfo {
+			if group != nil && group.ActionID > 0 && a.Actions[uint32(group.ActionID)] != nil {
+				a.UnlockActions[uint32(group.ActionID)] = true
+			}
+		}
+	}
+	a.MultipleActions = make(map[uint32]*excel.MultiplayerExpressionConfigure)
+	multiple := make(map[int32]*excel.MultiplayerExpressionConfigure)
+	for _, m := range expressions.GetMultiplayerExpression().GetDatas() {
+		if m != nil && m.PlayerNumber >= 2 && a.Actions[uint32(m.StarterPlayActionID)] != nil && a.Actions[uint32(m.RequesterPlayActionID)] != nil {
+			multiple[m.ID] = m
+		}
+	}
+	for _, e := range a.Expressions {
+		for _, group := range e.ExpressionGroupInfo {
+			if m := multiple[group.GetMultiplayerID()]; m != nil && a.Actions[uint32(group.GetActionID())] != nil {
+				a.MultipleActions[uint32(group.GetActionID())] = m
+			}
+		}
+	}
+	g.Excel.Appearance = a
+}
+
+func GetAppearance() *Appearance {
+	if cc == nil || cc.Excel == nil {
+		return nil
+	}
+	return cc.Excel.Appearance
+}
diff --git a/gdconf/excel.AppearanceExtras.go b/gdconf/excel.AppearanceExtras.go
new file mode 100644
index 0000000..5aea474
--- /dev/null
+++ b/gdconf/excel.AppearanceExtras.go
@@ -0,0 +1,137 @@
+package gdconf
+
+import (
+	"gucooing/lolo/protocol/excel"
+	"gucooing/lolo/protocol/proto"
+	"sort"
+)
+
+// AppearanceExtras joins cosmetic items to their actual model resources. Tool
+// skins, vehicles and shovels are weapons in this resource version, not tag 52.
+type AppearanceExtras struct {
+	Base       map[uint32]proto.EBagItemTag
+	Weapons    map[uint32]*excel.WeaponConfigure // canonical ItemID -> real weapon
+	Heads      map[uint32]bool
+	Categories map[string][]uint32
+}
+
+func AppearanceExtraWeaponCategory(t proto.EWeaponType) string {
+	switch t {
+	case proto.EWeaponType_EWeaponType_CollectionGloves:
+		return "collectionGloves"
+	case proto.EWeaponType_EWeaponType_LoggingAxe:
+		return "loggingAxe"
+	case proto.EWeaponType_EWeaponType_MiningHammer:
+		return "miningHammer"
+	case proto.EWeaponType_EWeaponType_InsectNet:
+		return "insectNet"
+	case proto.EWeaponType_EWeaponType_WaterBottle:
+		return "waterBottle"
+	case proto.EWeaponType_EWeaponType_FishingRod:
+		return "fishingRod"
+	case proto.EWeaponType_EWeaponType_Vehicle:
+		return "vehicle"
+	case proto.EWeaponType_EWeaponType_Shovel:
+		return "shovel"
+	}
+	return ""
+}
+
+func (g *GameConfig) loadAppearanceExtras() {
+	a := &AppearanceExtras{Base: map[uint32]proto.EBagItemTag{}, Weapons: map[uint32]*excel.WeaponConfigure{}, Heads: map[uint32]bool{}, Categories: map[string][]uint32{}}
+	umbrellas := new(excel.AllUmbrellaDatas)
+	pendants := new(excel.AllPendantDatas)
+	heads := new(excel.AllHeadDatas)
+	phones := new(excel.AllPhoneDatas)
+	weapons := new(excel.AllWeaponDatas)
+	ReadJson(g.excelPath, "Umbrella.json", umbrellas)
+	ReadJson(g.excelPath, "Pendant.json", pendants)
+	ReadJson(g.excelPath, "Head.json", heads)
+	ReadJson(g.excelPath, "Phone.json", phones)
+	ReadJson(g.excelPath, "Weapon.json", weapons)
+	validPhones := map[uint32]bool{}
+	for _, c := range phones.GetPhone().GetDatas() {
+		if c != nil && c.ID > 0 {
+			validPhones[uint32(c.ID)] = true
+		}
+	}
+	validUmbrellas, validPendants := map[uint32]bool{}, map[uint32]bool{}
+	for _, c := range umbrellas.GetUmbrella().GetDatas() {
+		// A canonical Umbrella row remains valid even when its optional asset
+		// path is empty; client visibility cannot be inferred from that alone.
+		if c != nil && c.ItemID > 0 {
+			validUmbrellas[uint32(c.ItemID)] = true
+		}
+	}
+	for _, c := range pendants.GetPendant().GetDatas() {
+		if c != nil && c.ID > 0 {
+			validPendants[uint32(c.ID)] = true
+		}
+	}
+	for _, c := range g.Excel.Item.ItemMap {
+		if c == nil || c.ID <= 0 {
+			continue
+		}
+		id := uint32(c.ID)
+		tag := proto.EBagItemTag(c.NewBagItemTag)
+		category := ""
+		switch tag {
+		case proto.EBagItemTag_EBagItemTag_Badge:
+			category = "badge"
+		case proto.EBagItemTag_EBagItemTag_Umbrella:
+			if validUmbrellas[id] {
+				category = "umbrella"
+			}
+		case proto.EBagItemTag_EBagItemTag_Pendant:
+			if validPendants[id] {
+				category = "pendant"
+			}
+		case proto.EBagItemTag_EBagItemTag_AvatarFrame:
+			category = "avatarFrame"
+		case proto.EBagItemTag_EBagItemTag_PhoneCase:
+			if validPhones[id] {
+				category = "phoneCase"
+			}
+		}
+		if category != "" {
+			a.Base[id] = tag
+			a.Categories[category] = append(a.Categories[category], id)
+		}
+	}
+	for _, c := range heads.GetHead().GetDatas() {
+		if c == nil || c.HeadID <= 0 {
+			continue
+		}
+		id := uint32(c.HeadID)
+		item := g.Excel.Item.ItemMap[id]
+		if item != nil && proto.EBagItemTag(item.NewBagItemTag) == proto.EBagItemTag_EBagItemTag_Head && !a.Heads[id] {
+			a.Heads[id] = true
+			a.Categories["head"] = append(a.Categories["head"], id)
+		}
+	}
+	for _, c := range weapons.GetWeapon().GetDatas() {
+		if c == nil || c.ID <= 0 || c.ID != c.ItemID || c.AssetFullName == "" {
+			continue
+		}
+		category := AppearanceExtraWeaponCategory(proto.EWeaponType(c.NewWeaponType))
+		id := uint32(c.ItemID)
+		item := g.Excel.Item.ItemMap[id]
+		loaded := g.Excel.Weapon.WeaponAllMap[uint32(c.ID)]
+		if category == "" || item == nil || proto.EBagItemTag(item.NewBagItemTag) != proto.EBagItemTag_EBagItemTag_Weapon || loaded == nil || loaded.PropertyGroup[10] == nil {
+			continue
+		}
+		a.Weapons[id] = c
+		a.Categories[category] = append(a.Categories[category], id)
+	}
+	for _, ids := range a.Categories {
+		sort.Slice(ids, func(i, j int) bool { return ids[i] < ids[j] })
+	}
+	g.Excel.AppearanceExtras = a
+}
+
+func GetAppearanceExtras() *AppearanceExtras {
+	if cc == nil || cc.Excel == nil {
