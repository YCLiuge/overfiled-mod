diff --git a/game/scene_multiple_action.go b/game/scene_multiple_action.go
new file mode 100644
index 0000000..06e0f42
--- /dev/null
+++ b/game/scene_multiple_action.go
@@ -0,0 +1,165 @@
+package game
+
+import (
+	"gucooing/lolo/game/model"
+	"gucooing/lolo/pkg/alg"
+	"gucooing/lolo/protocol/excel"
+	"gucooing/lolo/protocol/proto"
+)
+
+// EndTime is Unix seconds (client MultiplayerActionSystem compares it with
+// DateTimeUtils.GetCurrentTimestampBySeconds). The invitation window is server policy.
+const multipleActionInviteSeconds int64 = 30
+
+type multipleActionInvitation struct {
+	starter      *ScenePlayer
+	actionID     uint32
+	cfg          *excel.MultiplayerExpressionConfigure
+	endTime      int64
+	participants []*ScenePlayer // starter first; client applies resource roles in this order
+}
+type multipleActionAcceptCtx struct {
+	player   *ScenePlayer
+	req      *proto.MultipleActionAcceptReq
+	packetID uint32
+}
+
+func (g *Game) MultipleActionAccept(s *model.Player, msg *alg.GameMsg) {
+	sp := g.getWordInfo().getScenePlayer(s)
+	if sp == nil || sp.channelInfo == nil {
+		g.send(s, msg.PacketId, &proto.MultipleActionAcceptRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+		return
+	}
+	c := sp.channelInfo
+	select {
+	case c.multipleAcceptChan <- &multipleActionAcceptCtx{player: sp, req: msg.Body.(*proto.MultipleActionAcceptReq), packetID: msg.PacketId}:
+	case <-c.doneChan:
+		g.send(s, msg.PacketId, &proto.MultipleActionAcceptRsp{Status: proto.StatusCode_StatusCode_PLAYER_NOT_IN_CHANNEL})
+	}
+}
+
+func (c *ChannelInfo) actionMember(p *ScenePlayer) bool {
+	return p != nil && p.Player != nil && !p.retired.Load() && !p.NetFreeze && c.allPlayer[p.UserId] == p && p.channelInfo == c
+}
+
+func (c *ChannelInfo) inviteMultipleAction(ctx *ActionSyncCtx, cfg *excel.MultiplayerExpressionConfigure, now int64) {
+	if c.multipleActions == nil {
+		c.multipleActions = make(map[uint32]*multipleActionInvitation)
+	}
+	inv := &multipleActionInvitation{starter: ctx.ScenePlayer, actionID: ctx.ActionId, cfg: cfg, endTime: now + multipleActionInviteSeconds, participants: []*ScenePlayer{ctx.ScenePlayer}}
+	c.multipleActions[ctx.ScenePlayer.UserId] = inv
+	c.sendAllPlayer(0, &proto.SendActionNotice{Status: proto.StatusCode_StatusCode_OK, ActionId: ctx.ActionId, FromPlayerId: ctx.ScenePlayer.UserId, FromPlayerName: ctx.ScenePlayer.NickName, EndTime: inv.endTime, MultipleNeedCount: uint32(cfg.PlayerNumber - 1)})
+	c.sendAllPlayer(0, &proto.SendMultipleActionNotice{Status: proto.StatusCode_StatusCode_OK, ActionId: ctx.ActionId, FromPlayerId: ctx.ScenePlayer.UserId, EndTime: inv.endTime})
+}
+
+func (c *ChannelInfo) acceptMultipleAction(ctx *multipleActionAcceptCtx, now int64) {
+	rsp := &proto.MultipleActionAcceptRsp{Status: proto.StatusCode_StatusCode_MULTIPLE_ACTION_INVALID}
+	defer c.sendPlayer(ctx.player, ctx.packetID, rsp)
+	c.expireMultipleActions(now)
+	if !c.actionMember(ctx.player) || ctx.req == nil {
+		return
+	}
+	inv := c.multipleActions[ctx.req.FromPlayerId]
+	if inv == nil || inv.actionID != ctx.req.ActionId || inv.starter == ctx.player {
+		return
+	}
+	// Native ReqMultipleActionAccept writes only actionId/fromPlayerId and leaves
+	// status at NONE. Accept NONE or OK; errors cannot consume another player's invite.
+	if ctx.req.Status != proto.StatusCode_StatusCode_NONE && ctx.req.Status != proto.StatusCode_StatusCode_OK {
+		return
+	}
+	for _, p := range inv.participants {
+		if p == ctx.player {
+			return
+		}
+	}
+	// A participant cannot simultaneously join two invitations.
+	for _, other := range c.multipleActions {
+		for _, p := range other.participants {
+			if p == ctx.player {
+				return
+			}
+		}
+	}
+	// Joining a new action ends the requester's previous completed group.
+	c.cancelPlayerActiveMultipleActions(ctx.player)
+	inv.participants = append(inv.participants, ctx.player)
+	rsp.Status = proto.StatusCode_StatusCode_OK
+	if len(inv.participants) < int(inv.cfg.PlayerNumber) {
+		c.sendAllPlayer(0, &proto.SendActionNotice{Status: proto.StatusCode_StatusCode_OK, ActionId: inv.actionID, FromPlayerId: inv.starter.UserId, FromPlayerName: inv.starter.NickName, EndTime: inv.endTime, MultipleNeedCount: uint32(int(inv.cfg.PlayerNumber) - len(inv.participants))})
+		return
+	}
+	ids := make([]uint32, 0, len(inv.participants))
+	for _, p := range inv.participants {
+		ids = append(ids, p.UserId)
+	}
+	delete(c.multipleActions, inv.starter.UserId) // consume before broadcasting, so replays cannot start it again
+	if c.activeMultipleActions == nil {
+		c.activeMultipleActions = make(map[uint32]*multipleActionInvitation)
+	}
+	c.activeMultipleActions[inv.starter.UserId] = inv
+	c.sendAllPlayer(0, &proto.SendMultipleActionCompleteNotice{Status: proto.StatusCode_StatusCode_OK, ActionId: inv.actionID, FromPlayerId: inv.starter.UserId, ActionPlayerIds: ids})
+}
+
+func (c *ChannelInfo) cancelMultipleAction(id uint32) {
+	inv := c.multipleActions[id]
+	if inv == nil {
+		return
+	}
+	delete(c.multipleActions, id)
+	// Client OnSendMultipleActionCompleteNotice(actionId=0) calls
+	// StopLooping(fromPlayerId); there is no separate cancellation message.
+	c.sendAllPlayer(0, &proto.SendMultipleActionCompleteNotice{Status: proto.StatusCode_StatusCode_OK, FromPlayerId: inv.starter.UserId})
+}
+func (c *ChannelInfo) cancelPlayerMultipleActions(player *ScenePlayer) {
+	c.cancelPlayerActiveMultipleActions(player)
+	for id, inv := range c.multipleActions {
+		for _, p := range inv.participants {
+			if p == player {
+				c.cancelMultipleAction(id)
+				break
+			}
+		}
+	}
+}
+func (c *ChannelInfo) cancelActiveMultipleAction(id uint32) {
+	inv := c.activeMultipleActions[id]
+	if inv == nil {
+		return
+	}
+	delete(c.activeMultipleActions, id)
+	c.sendAllPlayer(0, &proto.SendMultipleActionCompleteNotice{Status: proto.StatusCode_StatusCode_OK, FromPlayerId: inv.starter.UserId})
+}
+func (c *ChannelInfo) cancelPlayerActiveMultipleActions(player *ScenePlayer) {
+	for id, inv := range c.activeMultipleActions {
+		for _, p := range inv.participants {
+			if p == player {
+				c.cancelActiveMultipleAction(id)
+				break
+			}
+		}
+	}
+}
+func (c *ChannelInfo) expireMultipleActions(now int64) {
+	// Completed groups have no server animation duration. Keep only membership
+	// until a new action/stop/leave, and never expire them at the invite deadline.
+	for id, inv := range c.activeMultipleActions {
+		for _, p := range inv.participants {
+			if !c.actionMember(p) {
+				c.cancelActiveMultipleAction(id)
+				break
+			}
+		}
+	}
+	for id, inv := range c.multipleActions {
+		invalid := now >= inv.endTime
+		for _, p := range inv.participants {
+			if !c.actionMember(p) {
+				invalid = true
+			}
+		}
+		if invalid {
+			c.cancelMultipleAction(id)
+		}
+	}
+}
