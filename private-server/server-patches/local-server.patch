diff --git a/game/model/shop_purchase.go b/game/model/shop_purchase.go
new file mode 100644
index 0000000..5cc0ce9
--- /dev/null
+++ b/game/model/shop_purchase.go
@@ -0,0 +1,333 @@
+package model
+
+import (
+	"errors"
+	"fmt"
+	"math"
+	"sort"
+
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/excel"
+	"gucooing/lolo/protocol/proto"
+)
+
+var (
+	ErrShopInvalid     = errors.New("invalid shop purchase")
+	ErrShopConfig      = errors.New("incomplete shop configuration")
+	ErrShopUnsupported = errors.New("unsupported shop purchase semantics")
+	ErrShopNotEnough   = errors.New("not enough shop currency")
+	ErrShopLimit       = errors.New("shop purchase limit exceeded")
+	ErrShopOverflow    = errors.New("shop purchase quantity overflow")
+)
+
+// shopBaseTag contains only quantities represented by ordinary inventory records.
+// Memberships, unlocks, experience, energy, characters and equipment need their
+// own gameplay transactions and must never be silently issued as base items.
+func shopBaseTag(tag proto.EBagItemTag) bool {
+	if giftBaseTag(tag) {
+		return true
+	}
+	switch tag {
+	case proto.EBagItemTag_EBagItemTag_Collection, proto.EBagItemTag_EBagItemTag_Food,
+		proto.EBagItemTag_EBagItemTag_SpellCard, proto.EBagItemTag_EBagItemTag_Item,
+		proto.EBagItemTag_EBagItemTag_Fish, proto.EBagItemTag_EBagItemTag_Recipe,
+		proto.EBagItemTag_EBagItemTag_Baitbox, proto.EBagItemTag_EBagItemTag_Quest,
+		proto.EBagItemTag_EBagItemTag_CharacterBadge, proto.EBagItemTag_EBagItemTag_DyeStuff,
+		proto.EBagItemTag_EBagItemTag_MoonStone, proto.EBagItemTag_EBagItemTag_Umbrella,
+		proto.EBagItemTag_EBagItemTag_Badge, proto.EBagItemTag_EBagItemTag_Furniture,
+		proto.EBagItemTag_EBagItemTag_TeleportKey, proto.EBagItemTag_EBagItemTag_WallPaper,
+		proto.EBagItemTag_EBagItemTag_PhoneCase, proto.EBagItemTag_EBagItemTag_Pendant,
+		proto.EBagItemTag_EBagItemTag_AvatarFrame, proto.EBagItemTag_EBagItemTag_MusicNote,
+		proto.EBagItemTag_EBagItemTag_SeasonalMiniGamesItem, proto.EBagItemTag_EBagItemTag_TreasureMap,
+		proto.EBagItemTag_EBagItemTag_TreasureMapFrag, proto.EBagItemTag_EBagItemTag_Catcher,
+		proto.EBagItemTag_EBagItemTag_PetGrid, proto.EBagItemTag_EBagItemTag_PetMmaterials:
+		return true
+	}
+	return false
+}
+
+func (s *Player) shopGridRecord(shopID, gridID uint32) *GridInfo {
+	if s != nil && s.Shop != nil {
+		if shop := s.Shop.ShopInfos[shopID]; shop != nil {
+			return shop.ShopGrids[gridID]
+		}
+	}
+	return nil
+}
+
+// ResolveShopOffer is read-only, including for a player with no shop state.
+// itemID=0 selects the persisted index (when valid), then the lowest valid index.
+// An explicit itemID must belong to the currently active (first/regular) pool.
+func (s *Player) ResolveShopOffer(shopID, gridID, itemID uint32) (*excel.ShopPoolConfigureItem, uint32, error) {
+	shop := gdconf.GetShopInfo(shopID)
+	if s == nil || shopID == 0 || gridID == 0 || shop == nil {
+		return nil, 0, ErrShopInvalid
+	}
+	grid := gdconf.GetGrid(shopID, gridID)
+	if grid == nil || grid.ShopPoolID <= 0 {
+		return nil, 0, ErrShopInvalid
+	}
+	poolID := uint32(grid.ShopPoolID)
+	old := s.shopGridRecord(shopID, gridID)
+	if (old == nil || old.BuyTimes == 0) && grid.FirstBuyShopPoolID > 0 {
+		poolID = uint32(grid.FirstBuyShopPoolID)
+	}
+	var chosen *excel.ShopPoolConfigureItem
+	for index, offer := range gdconf.GetPools(poolID) {
+		if offer == nil || offer.Index <= 0 || uint32(offer.Index) != index || (offer.ItemID <= 0 && !(shop.NewShopType == int32(proto.EShopType_EShopType_CharacterBP) && offer.ItemID == 0)) {
+			continue
+		}
+		if itemID != 0 && uint32(offer.ItemID) != itemID {
+			continue
+		}
+		if itemID == 0 && old != nil && old.PoolID == poolID && old.PoolIndex == index {
+			return offer, poolID, nil
+		}
+		if chosen == nil || offer.Index < chosen.Index {
+			chosen = offer
+		}
+	}
+	if chosen == nil {
+		return nil, 0, ErrShopInvalid
+	}
+	return chosen, poolID, nil
+}
+
+// PurchaseShop is owned exclusively by the player's main loop. It validates and
+// stages every price, gain and counter before committing any inventory/shop state.
+// Rewards are gains; notice contains final absolute balances, including costs.
+func (s *Player) PurchaseShop(shopID, gridID, itemID, buyTimes uint32, sandbox bool) ([]*proto.ItemDetail, *proto.PackNotice, *proto.ShopGrid, error) {
+	fail := func(err error) ([]*proto.ItemDetail, *proto.PackNotice, *proto.ShopGrid, error) {
+		return nil, nil, nil, err
+	}
+	if buyTimes == 0 {
+		return fail(ErrShopInvalid)
+	}
+	offer, poolID, err := s.ResolveShopOffer(shopID, gridID, itemID)
+	if err != nil {
+		return fail(err)
+	}
+	shop, gc := gdconf.GetShopInfo(shopID), gdconf.GetGrid(shopID, gridID)
+	var paymentCharacter *CharacterInfo
+	if shop.NewShopType == int32(proto.EShopType_EShopType_CharacterBP) {
+		cc := gdconf.GetCharacterInfoByShop(shopID)
+		if cc == nil || cc.ID <= 0 || s.Character == nil {
+			return fail(fmt.Errorf("%w: missing character entitlement mapping or owned character", ErrShopConfig))
+		}
+		paymentCharacter = s.Character.CharacterMap[uint32(cc.ID)]
+		if paymentCharacter == nil || paymentCharacter.CharacterId != uint32(cc.ID) {
+			return fail(fmt.Errorf("%w: missing owned character", ErrShopConfig))
+		}
+		if !sandbox && paymentCharacter.IsUnlockPayment {
+			return fail(fmt.Errorf("%w: character already unlocked", ErrShopLimit))
+		}
+		if offer.ItemID != 0 || offer.ItemNum != 0 || offer.AddItemNum != 0 {
+			return fail(ErrShopUnsupported)
+		}
+	} else if itemID == 0 {
+		return fail(ErrShopInvalid)
+	}
+	switch proto.EShopType(shop.NewShopType) {
+	case proto.EShopType_EShopType_SingleShop, proto.EShopType_EShopType_MultiShop,
+		proto.EShopType_EShopType_ActivityGift, proto.EShopType_EShopType_Recommending,
+		proto.EShopType_EShopType_ConvertShop, proto.EShopType_EShopType_LimitShop:
+	case proto.EShopType_EShopType_CharacterBP:
+		// Entitlement is staged above and committed alongside its validated price.
+	case proto.EShopType_EShopType_RechargeShop:
+		if !sandbox {
+			return fail(fmt.Errorf("%w: real-money recharge", ErrShopUnsupported))
+		}
+	default:
+		return fail(fmt.Errorf("%w: shop type %d", ErrShopUnsupported, shop.NewShopType))
+	}
+	old := s.shopGridRecord(shopID, gridID)
+	var bought uint32
+	if old != nil {
+		bought = old.BuyTimes
+	}
+	if buyTimes > math.MaxUint32-bought {
+		return fail(ErrShopOverflow)
+	}
+	if !sandbox {
+		if gc.BuyMaxCount < -1 {
+			return fail(ErrShopConfig)
+		}
+		if gc.BuyMaxCount >= 0 && uint64(bought)+uint64(buyTimes) > uint64(gc.BuyMaxCount) {
+			return fail(ErrShopLimit)
+		}
+		if shop.UnlockItemID != 0 || shop.OpeningTime != "" || shop.ClosingTime != "" || gc.NewGridConditionType != 0 || gc.ConditionParam != "" {
+			return fail(ErrShopUnsupported)
+		}
+	}
+	type part struct {
+		offer *excel.ShopPoolConfigureItem
+		count uint32
+	}
+	parts := []part{{offer, buyTimes}}
+	// A batch crossing the first-purchase boundary uses the first pool exactly once.
+	if bought == 0 && gc.FirstBuyShopPoolID > 0 && gc.FirstBuyShopPoolID != gc.ShopPoolID && buyTimes > 1 {
+		regularPlayer := &Player{Shop: &ShopModel{ShopInfos: map[uint32]*ShopInfo{shopID: {ShopGrids: map[uint32]*GridInfo{gridID: {BuyTimes: 1}}}}}}
+		regular, _, e := regularPlayer.ResolveShopOffer(shopID, gridID, itemID)
+		if e != nil {
+			return fail(e)
+		}
+		parts = []part{{offer, 1}, {regular, buyTimes - 1}}
+	}
+	gains, costs := map[uint32]int64{}, map[uint32]int64{}
+	add := func(m map[uint32]int64, id int32, count int32, times uint32) error {
+		if id <= 0 || count <= 0 {
+			return ErrShopConfig
+		}
+		c := gdconf.GetItemConfigure(uint32(id))
+		if c == nil || c.ID != id {
+			return fmt.Errorf("%w: item %d", ErrShopConfig, id)
+		}
+		if !shopBaseTag(proto.EBagItemTag(c.NewBagItemTag)) {
+			return fmt.Errorf("%w: item %d tag %d", ErrShopUnsupported, id, c.NewBagItemTag)
+		}
+		n := int64(count) * int64(times) // positive int32 * uint32 fits int64
+		if m[uint32(id)] > math.MaxInt64-n {
+			return ErrShopOverflow
+		}
+		m[uint32(id)] += n
+		return nil
+	}
+	for _, p := range parts {
+		o := p.offer
+		if !sandbox && !o.IsRepeatedInBag {
+			var owned int64
+			if s.Item != nil && s.Item.ItemBaseInfo[uint32(o.ItemID)] != nil {
+				owned = s.Item.ItemBaseInfo[uint32(o.ItemID)].Num
+			}
+			if owned > 0 || p.count > 1 {
+				return fail(fmt.Errorf("%w: nonrepeatable item %d", ErrShopLimit, o.ItemID))
+			}
+		}
+		if !sandbox && (o.MinLevel > 1 || (o.MaxLevel != 0 && o.MaxLevel != 100) || o.OpeningTime != "" || o.ClosingTime != "" || (o.Discount != 0 && o.Discount != 1)) {
+			return fail(ErrShopUnsupported)
+		}
+		if paymentCharacter == nil {
+			if err := add(gains, o.ItemID, o.ItemNum, p.count); err != nil {
+				return fail(err)
+			}
+		}
+		if o.AddItemNum < 0 {
+			return fail(ErrShopConfig)
+		}
+		if o.AddItemNum > 0 {
+			if err := add(gains, o.AddItemID, o.AddItemNum, p.count); err != nil {
+				return fail(err)
+			}
+		}
+		for _, price := range o.ShopCurrencyItem {
+			if price == nil || price.CurrencyID < 0 || price.Price < 0 {
+				return fail(ErrShopConfig)
+			}
+			if price.CurrencyID == 0 {
+				if !sandbox {
+					return fail(fmt.Errorf("%w: real-money price", ErrShopUnsupported))
+				}
+				continue
+			}
+			c := gdconf.GetItemConfigure(uint32(price.CurrencyID))
+			if c == nil || !shopBaseTag(proto.EBagItemTag(c.NewBagItemTag)) {
+				return fail(ErrShopConfig)
+			}
+			if !sandbox {
+				if price.IncreasingID != 0 || price.WishlistPrice != 0 || price.WishlistDiscount != 0 {
+					return fail(ErrShopUnsupported)
+				}
+				if price.Price > 0 {
+					if err := add(costs, price.CurrencyID, price.Price, p.count); err != nil {
+						return fail(err)
+					}
+				}
+			}
+		}
+	}
+	i := s.Item
+	if i == nil {
+		i = &ItemModel{}
+	}
+	// Gross affordability is checked before gains: an offer cannot pay for itself.
+	for id, cost := range costs {
+		owned := i.ItemBaseInfo[id]
+		if owned == nil || owned.Num < cost {
+			return fail(ErrShopNotEnough)
+		}
+	}
+	idsMap := map[uint32]bool{}
+	for id := range gains {
+		idsMap[id] = true
+	}
+	for id := range costs {
+		idsMap[id] = true
+	}
+	ids := make([]uint32, 0, len(idsMap))
+	staged := make(map[uint32]*ItemBaseInfo, len(idsMap))
+	for id := range idsMap {
+		c := gdconf.GetItemConfigure(id)
+		record := &ItemBaseInfo{ItemId: id, ItemType: proto.EBagItemTag(c.NewBagItemTag), PackType: proto.ItemDetail_PackType_Inventory}
+		if old := i.ItemBaseInfo[id]; old != nil {
+			if old.ItemId != id || old.ItemType != record.ItemType || old.PackType != proto.ItemDetail_PackType_Inventory || old.Num < 0 {
+				return fail(ErrShopConfig)
+			}
+			*record = *old
+		}
+		// Check the actual post-deduction balance, avoiding false overflow on exchanges.
+		record.Num -= costs[id]
+		if record.Num > math.MaxInt64-gains[id] {
+			return fail(ErrShopOverflow)
+		}
+		record.Num += gains[id]
+		staged[id] = record
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(a, b int) bool { return ids[a] < ids[b] })
+	notice := &proto.PackNotice{Status: proto.StatusCode_StatusCode_OK}
+	rewards := make([]*proto.ItemDetail, 0, len(gains))
+	for _, id := range ids {
+		record := staged[id]
+		notice.Items = append(notice.Items, record.ItemDetail())
+		if gain := gains[id]; gain > 0 {
+			copyRecord := *record
+			copyRecord.Num = gain
+			rewards = append(rewards, copyRecord.ItemDetail())
+		}
+	}
+	grid := &GridInfo{ShopID: shopID, GridID: gridID, PoolID: poolID, PoolIndex: uint32(offer.Index), BuyTimes: bought + buyTimes}
+	// Persist and expose the next active offer, so a completed first purchase
+	// immediately advertises the regular pool to the client's next order.
+	nextPlayer := &Player{Shop: &ShopModel{ShopInfos: map[uint32]*ShopInfo{shopID: {ShopGrids: map[uint32]*GridInfo{gridID: grid}}}}}
+	nextOffer, nextPoolID, err := nextPlayer.ResolveShopOffer(shopID, gridID, 0)
+	if err != nil {
+		return fail(err)
+	}
+	grid.PoolID, grid.PoolIndex = nextPoolID, uint32(nextOffer.Index)
+	// No validation or fallible operation follows this commit boundary.
+	if paymentCharacter != nil {
+		paymentCharacter.IsUnlockPayment = true
+	}
+	if i.ItemBaseInfo == nil {
+		i.ItemBaseInfo = make(map[uint32]*ItemBaseInfo)
+	}
+	for id, record := range staged {
+		i.ItemBaseInfo[id] = record
+	}
+	s.Item = i
+	if s.Shop == nil {
+		s.Shop = &ShopModel{}
+	}
+	if s.Shop.ShopInfos == nil {
+		s.Shop.ShopInfos = make(map[uint32]*ShopInfo)
+	}
+	if s.Shop.ShopInfos[shopID] == nil {
+		s.Shop.ShopInfos[shopID] = &ShopInfo{ShopID: shopID}
+	}
+	shopRecord := s.Shop.ShopInfos[shopID]
+	if shopRecord.ShopGrids == nil {
+		shopRecord.ShopGrids = make(map[uint32]*GridInfo)
+	}
+	shopRecord.ShopGrids[gridID] = grid
+	return rewards, notice, grid.ShopGrid(), nil
+}
diff --git a/game/model/treasure_illustration.go b/game/model/treasure_illustration.go
new file mode 100644
index 0000000..0441323
--- /dev/null
+++ b/game/model/treasure_illustration.go
@@ -0,0 +1,185 @@
+package model
+
+import (
+	"errors"
+	"math"
+	"sort"
+
+	"gucooing/lolo/gdconf"
+	"gucooing/lolo/protocol/proto"
+)
+
+var (
+	ErrTreasureIllustrationInvalid     = errors.New("invalid treasure illustration request")
+	ErrTreasureIllustrationUnsupported = errors.New("unsupported treasure illustration semantics")
+	ErrTreasureIllustrationConfig      = errors.New("incomplete treasure illustration configuration")
+	ErrTreasureIllustrationOverflow    = errors.New("treasure illustration quantity overflow")
+)
+
+// TreasureIllustrationModel is part of the player JSON snapshot. Lists contain
+// source-table IDs, not item IDs or collection/reward pool IDs.
+type TreasureIllustrationModel struct {
+	BookReward     []uint32 `json:"bookReward,omitempty"`
+	UtensilReward  []uint32 `json:"utensilReward,omitempty"`
+	TreasureReward []uint32 `json:"treasureReward,omitempty"`
+	ShovelReward   []uint32 `json:"shovelReward,omitempty"`
+}
+
+func (s *Player) GetTreasureIllustrationInfo() *proto.TreasureIllustrationInfoRsp {
+	info := &proto.TreasureIllustrationInfoRsp{Status: proto.StatusCode_StatusCode_OK}
+	if s == nil || s.TreasureIllustration == nil {
+		return info
+	}
+	m := s.TreasureIllustration
+	info.BookReward = append([]uint32(nil), m.BookReward...)
+	info.UtensilReward = append([]uint32(nil), m.UtensilReward...)
+	info.TreasureReward = append([]uint32(nil), m.TreasureReward...)
+	info.ShovelReward = append([]uint32(nil), m.ShovelReward...)
+	return info
+}
+
+func illustrationClaims(m *TreasureIllustrationModel, kind proto.EArchaeologyType) *[]uint32 {
+	switch kind {
+	case proto.EArchaeologyType_EArchaeologyType_Book:
+		return &m.BookReward
+	case proto.EArchaeologyType_EArchaeologyType_Utensil:
+		return &m.UtensilReward
+	case proto.EArchaeologyType_EArchaeologyType_Shovel:
+		return &m.ShovelReward
+	}
+	return nil
+}
+
+// ClaimTreasureIllustration is a sandbox operation owned by the game loop, like
+// UseGift. The handler enforces sandbox mode. All configuration, gains and final
+// balances are staged before committing inventory and the claim together. A
+// repeated claim succeeds with no rewards and no inventory notice.
+func (s *Player) ClaimTreasureIllustration(kind proto.EArchaeologyType, id uint32) ([]*proto.ItemDetail, *proto.PackNotice, error) {
+	fail := func(err error) ([]*proto.ItemDetail, *proto.PackNotice, error) { return nil, nil, err }
+	if s == nil || id == 0 {
+		return fail(ErrTreasureIllustrationInvalid)
+	}
+	m := s.TreasureIllustration
+	if m == nil {
+		m = &TreasureIllustrationModel{}
+	}
+	claims := illustrationClaims(m, kind)
+	if claims == nil {
+		return fail(ErrTreasureIllustrationUnsupported)
+	}
+	i := s.Item
+	if i == nil {
+		i = &ItemModel{}
+	}
+	i.transactionLock.Lock()
+	defer i.transactionLock.Unlock()
+	for _, claimed := range *claims {
+		if claimed == id {
+			return nil, nil, nil
+		}
+	}
+	conf := gdconf.GetTreasureIllustration()
+	if conf == nil {
+		return fail(ErrTreasureIllustrationConfig)
+	}
+	var collectionID int32
+	switch kind {
+	case proto.EArchaeologyType_EArchaeologyType_Book:
+		v := conf.Books[id]
+		if v == nil || v.ID <= 0 || uint32(v.ID) != id {
+			return fail(ErrTreasureIllustrationInvalid)
+		}
+		collectionID = v.CollectionID
+	case proto.EArchaeologyType_EArchaeologyType_Utensil:
+		v := conf.Utensils[id]
+		if v == nil || v.ID <= 0 || uint32(v.ID) != id {
+			return fail(ErrTreasureIllustrationInvalid)
+		}
+		collectionID = v.CollectionID
+	case proto.EArchaeologyType_EArchaeologyType_Shovel:
+		v := conf.Shovels[id]
+		if v == nil || v.ID <= 0 || uint32(v.ID) != id {
+			return fail(ErrTreasureIllustrationInvalid)
+		}
+		collectionID = v.CollectionID
+	}
+	if collectionID <= 0 {
+		return fail(ErrTreasureIllustrationConfig)
+	}
+	pool := gdconf.GetRewardPool(uint32(collectionID))
+	if pool == nil || pool.ID != collectionID || len(pool.RewardPoolGroup) == 0 {
+		return fail(ErrTreasureIllustrationConfig)
+	}
+	gains := make(map[uint32]int64)
+	for _, ref := range pool.RewardPoolGroup {
+		if ref == nil || ref.RewardPoolGroupID <= 0 {
+			return fail(ErrTreasureIllustrationConfig)
+		}
+		items := gdconf.GetRewardItemPool(uint32(ref.RewardPoolGroupID))
+		if items == nil || items.ID != ref.RewardPoolGroupID || len(items.RewardItemPoolGroup) == 0 {
+			return fail(ErrTreasureIllustrationConfig)
+		}
+		for _, reward := range items.RewardItemPoolGroup {
+			if reward == nil || reward.ItemID <= 0 || reward.ItemMinCount <= 0 {
+				return fail(ErrTreasureIllustrationConfig)
+			}
+			if reward.ItemMinCount != reward.ItemMaxCount || len(reward.NeedItems) != 0 || reward.MinLevelLimit != 1 || reward.MaxLevelLimit != 100 {
+				return fail(ErrTreasureIllustrationUnsupported)
+			}
+			itemID := uint32(reward.ItemID)
+			rc := gdconf.GetItemConfigure(itemID)
+			if rc == nil || rc.ID != reward.ItemID {
+				return fail(ErrTreasureIllustrationConfig)
+			}
+			// Treasure maps are also ordinary ItemBaseInfo balances (5070001
+			// is the additional configured reward for Shovel 1007003).
+			if !giftBaseTag(proto.EBagItemTag(rc.NewBagItemTag)) && proto.EBagItemTag(rc.NewBagItemTag) != proto.EBagItemTag_EBagItemTag_TreasureMap {
+				return fail(ErrTreasureIllustrationUnsupported)
+			}
+			gain := int64(reward.ItemMinCount)
+			if gains[itemID] > math.MaxInt64-gain {
+				return fail(ErrTreasureIllustrationOverflow)
+			}
+			gains[itemID] += gain
+		}
+	}
+	ids := make([]uint32, 0, len(gains))
+	staged := make(map[uint32]*ItemBaseInfo, len(gains))
+	for itemID, gain := range gains {
+		rc := gdconf.GetItemConfigure(itemID)
+		record := &ItemBaseInfo{ItemId: itemID, ItemType: proto.EBagItemTag(rc.NewBagItemTag), PackType: proto.ItemDetail_PackType_Inventory}
+		if old := i.ItemBaseInfo[itemID]; old != nil {
+			if old.ItemId != itemID || old.ItemType != record.ItemType || old.Num < 0 || old.PackType != proto.ItemDetail_PackType_Inventory {
+				return fail(ErrTreasureIllustrationConfig)
+			}
+			*record = *old
+		}
+		if record.Num > math.MaxInt64-gain {
+			return fail(ErrTreasureIllustrationOverflow)
+		}
+		record.Num += gain
+		staged[itemID] = record
+		ids = append(ids, itemID)
+	}
+	sort.Slice(ids, func(a, b int) bool { return ids[a] < ids[b] })
+	pack := &proto.PackNotice{Status: proto.StatusCode_StatusCode_OK}
+	rewards := make([]*proto.ItemDetail, 0, len(ids))
+	for _, itemID := range ids {
+		record := staged[itemID]
+		pack.Items = append(pack.Items, record.ItemDetail())
+		gainRecord := *record
+		gainRecord.Num = gains[itemID]
+		rewards = append(rewards, gainRecord.ItemDetail())
+	}
+	// No validation or other fallible operation follows this commit point.
+	if i.ItemBaseInfo == nil {
+		i.ItemBaseInfo = make(map[uint32]*ItemBaseInfo, len(staged))
+	}
+	for itemID, record := range staged {
+		i.ItemBaseInfo[itemID] = record
+	}
+	*claims = append(*claims, id)
+	s.Item = i
+	s.TreasureIllustration = m
+	return rewards, pack, nil
+}
