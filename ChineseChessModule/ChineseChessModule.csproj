<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework><OutputType>Library</OutputType>
    <AssemblyName>ChineseChessModule</AssemblyName><RootNamespace>ChineseChessModule</RootNamespace>
    <Version>1.0.4</Version><ModuleId>chinese_chess</ModuleId><ModulePriority>110</ModulePriority>
