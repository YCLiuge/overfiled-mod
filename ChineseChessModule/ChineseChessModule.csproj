    <Platforms>AnyCPU;x64</Platforms><PlatformTarget>x64</PlatformTarget><LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDependencyFile>false</GenerateDependencyFile><ProduceReferenceAssembly>false</ProduceReferenceAssembly>
  </PropertyGroup>
  <ItemGroup>
