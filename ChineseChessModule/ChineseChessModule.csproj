    <Reference Include="Newtonsoft.Json"><HintPath>..\libs\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>..\libs\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>..\libs\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
