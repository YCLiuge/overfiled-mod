<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Chat.Server</RootNamespace>
    <AssemblyName>Chat.Server</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.1</Version>
    <InformationalVersion>1.0.1-board</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chat.Protocol 是共享源码目录：直接编进本程序集，服务器与客户端保持一致且不需要额外 DLL -->
    <Compile Include="..\Chat.Protocol\**\*.cs"
             Exclude="..\Chat.Protocol\bin\**;..\Chat.Protocol\obj\**"
             Link="Protocol\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
